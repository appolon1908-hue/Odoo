{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codestra.example/schemas/integration-event-envelope-v1.schema.json",
  "title": "Codestra Integration Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_type", "event_version", "occurred_at", "tenant_id", "idempotency_key", "payload"],
  "properties": {
    "event_type": {"type": "string", "minLength": 3},
    "event_version": {"const": "1.0"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": "string", "minLength": 1},
    "customer_id": {"type": ["string", "null"]},
    "correlation_id": {"type": "string"},
    "causation_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "metadata": {"type": "object"}
  }
}
