ENVIRONMENT=production-read-only-canary
SOURCE_SHA=REQUIRED_AT_RUNTIME
ODOO_IMAGE_DIGEST=REQUIRED_AT_RUNTIME
PAIRED_BACKUP_ID=REQUIRED_AT_RUNTIME
ROLLBACK_TARGET_DIGEST=REQUIRED_AT_RUNTIME
LIVE_ODOO_WRITE=false
ENABLE_EXTERNAL_DELIVERY=false
EMAIL_DELIVERY=false
SMS_DELIVERY=false
CALLBACK_DISPATCH=false
PSTN_DIALING=false
N8N_ACTIVATION=false
VICIDIAL_LIVE_CONTROL=false
