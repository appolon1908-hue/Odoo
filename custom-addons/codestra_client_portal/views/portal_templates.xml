<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_dashboard" name="Codestra Client Dashboard">
    <t t-call="portal.portal_layout">
      <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h1>Codestra Client Operations</h1>
            <p class="text-muted" t-esc="client.display_name"/>
          </div>
        </div>
        <h2>Contracts</h2>
        <div class="table-responsive mb-5">
          <table class="table table-hover">
            <thead><tr><th>Contract</th><th>Version</th><th>Billing</th><th>Status</th></tr></thead>
            <tbody>
              <tr t-foreach="contracts" t-as="contract">
                <td><a t-att-href="'/my/codestra/contracts/%s' % contract.id" t-esc="contract.name"/></td>
                <td t-esc="contract.version"/>
                <td t-esc="contract.billing_model"/>
                <td t-esc="contract.state"/>
              </tr>
            </tbody>
          </table>
        </div>
        <h2>Approved Usage</h2>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead><tr><th>Reference</th><th>Date</th><th>Units</th><th>Revenue</th><th>Margin</th></tr></thead>
            <tbody>
              <tr t-foreach="usage" t-as="item">
                <td t-esc="item.source_reference"/>
                <td t-esc="item.occurred_at"/>
                <td t-esc="item.units"/>
                <td t-esc="item.revenue"/>
                <td t-esc="item.margin"/>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </t>
  </template>

  <template id="portal_contract" name="Codestra Client Contract">
    <t t-call="portal.portal_layout">
      <div class="container py-4">
        <a href="/my/codestra" class="btn btn-link px-0">Back to client operations</a>
        <h1><span t-esc="contract.name"/> v<span t-esc="contract.version"/></h1>
        <p t-esc="contract.service_scope"/>
        <dl class="row">
          <dt class="col-sm-3">Status</dt><dd class="col-sm-9" t-esc="contract.state"/>
          <dt class="col-sm-3">Effective</dt><dd class="col-sm-9"><span t-esc="contract.start_date"/> — <span t-esc="contract.end_date or 'Open ended'"/></dd>
          <dt class="col-sm-3">Billing</dt><dd class="col-sm-9" t-esc="contract.billing_model"/>
        </dl>
        <h2>SLAs</h2>
        <table class="table table-hover">
          <thead><tr><th>Metric</th><th>Target</th><th>Unit</th></tr></thead>
          <tbody>
            <tr t-foreach="contract.sla_ids.filtered('active')" t-as="sla">
              <td t-esc="sla.name"/>
              <td><span t-esc="sla.operator"/> <span t-esc="sla.target_value"/></td>
              <td t-esc="sla.unit"/>
            </tr>
          </tbody>
        </table>
        <h2>Approved Usage</h2>
        <table class="table table-hover">
          <thead><tr><th>Reference</th><th>Units</th><th>Revenue</th><th>Cost</th><th>Margin</th></tr></thead>
          <tbody>
            <tr t-foreach="usage" t-as="item">
              <td t-esc="item.source_reference"/>
              <td t-esc="item.units"/>
              <td t-esc="item.revenue"/>
              <td t-esc="item.provider_cost"/>
              <td t-esc="item.margin"/>
            </tr>
          </tbody>
        </table>
      </div>
    </t>
  </template>
</odoo>
