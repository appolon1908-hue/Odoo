<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="codestra_login_layout"
        inherit_id="web.login_layout"
        name="Codestra Login Layout"
        priority="50"
    >
        <!--
            Odoo's optional website module replaces the entire direct t-call in
            web.login_layout at priority 20. Override that stable root boundary
            instead of targeting implementation details inside the original
            web.frontend_layout body. This keeps the authentication surface
            installable and branded whether website is installed before, after,
            or not at all.
        -->
        <xpath expr="t[@t-call]" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}" />
                <t t-set="body_classname" t-value="'codestra-auth-body'" />
                <t t-set="no_header" t-value="True" />
                <t t-set="no_footer" t-value="True" />
                <t t-set="title">Codestra CRM</t>
                <t
                    t-set="x_icon"
                    t-value="'/codestra_login_branding/static/src/img/codestra-mark.svg'"
                />

                <div class="codestra-login-shell">
                    <section
                        class="codestra-login-brand"
                        aria-labelledby="codestra-brand-title"
                    >
                        <div class="codestra-login-brand__inner">
                            <div
                                class="codestra-wordmark"
                                role="img"
                                aria-label="Codestra"
                            >
                                <span
                                    class="codestra-wordmark__mark"
                                    aria-hidden="true"
                                >C</span>
                                <span class="codestra-wordmark__name">CODESTRA</span>
                            </div>

                            <div class="codestra-login-brand__copy">
                                <p class="codestra-eyebrow">Codestra Business Suite</p>
                                <h1 id="codestra-brand-title">
                                    One secure workspace for customer operations.
                                </h1>
                                <p>
                                    Manage conversations, callbacks, campaigns, and service
                                    activity from one controlled business system.
                                </p>
                            </div>

                            <ul
                                class="codestra-capabilities"
                                aria-label="Platform capabilities"
                            >
                                <li>CRM</li>
                                <li>Communications</li>
                                <li>Operations</li>
                            </ul>

                            <div class="codestra-access-notice">
                                <span
                                    class="codestra-access-notice__indicator"
                                    aria-hidden="true"
                                ></span>
                                <span>Authorized access only</span>
                            </div>
                        </div>
                    </section>

                    <section
                        class="codestra-login-stage"
                        aria-labelledby="codestra-login-title"
                    >
                        <div class="codestra-login-card o_database_list">
                            <div class="codestra-login-card__header">
                                <div
                                    class="codestra-login-card__mobile-brand"
                                    role="img"
                                    aria-label="Codestra"
                                >
                                    <span
                                        class="codestra-wordmark__mark"
                                        aria-hidden="true"
                                    >C</span>
                                    <span class="codestra-wordmark__name">CODESTRA</span>
                                </div>
                                <p class="codestra-eyebrow">Codestra CRM</p>
                                <h2 id="codestra-login-title">Secure access</h2>
                                <p>Sign in with your authorized company account.</p>
                            </div>

                            <t t-out="0" />

                            <div
                                class="codestra-login-card__footer"
                                t-if="not disable_footer"
                            >
                                <span>Protected business workspace</span>
                                <span aria-hidden="true">•</span>
                                <span>Codestra</span>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </xpath>
    </template>

    <template
        id="codestra_login_form"
        inherit_id="web.login"
        name="Codestra Login Form"
        priority="50"
    >
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="form-label">Work email</label>
        </xpath>

        <xpath expr="//input[@id='login']" position="attributes">
            <attribute name="placeholder">name@company.com</attribute>
            <attribute name="inputmode">email</attribute>
            <attribute name="aria-describedby">codestra-login-help</attribute>
        </xpath>

        <xpath expr="//label[@for='password']" position="replace">
            <label for="password" class="form-label">Password</label>
        </xpath>

        <xpath
            expr="//div[
                contains(
                    concat(' ', normalize-space(@class), ' '),
                    ' oe_login_buttons '
                )
            ]/button[@type='submit'][1]"
            position="replace"
        >
            <button type="submit" class="btn codestra-login-button">
                Continue securely
            </button>
        </xpath>

        <xpath
            expr="//form[
                contains(@t-attf-class, 'oe_login_form')
            ]/input[@name='redirect']"
            position="after"
        >
            <p id="codestra-login-help" class="codestra-login-help">
                Use your authorized company account. Contact your administrator
                if access has not been provisioned.
            </p>
        </xpath>
    </template>
</odoo>
