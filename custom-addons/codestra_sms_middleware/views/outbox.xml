<odoo>
  <record id="sms_outbox_list" model="ir.ui.view">
    <field name="name">codestra.sms.outbox.list</field>
    <field name="model">codestra.sms.outbox</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0">
        <field name="lead_id"/><field name="company_id"/><field name="state"/>
        <field name="middleware_status"/><field name="message_id"/>
        <field name="attempts"/><field name="last_error_code"/><field name="next_attempt_at"/>
      </list>
    </field>
  </record>
  <record id="sms_outbox_action" model="ir.actions.act_window">
    <field name="name">SMS Delivery</field>
    <field name="res_model">codestra.sms.outbox</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="sms_outbox_menu" name="SMS Delivery" parent="base.menu_administration" action="sms_outbox_action" groups="base.group_system"/>
</odoo>
