<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_campaign_form_foundation" model="ir.ui.view">
    <field name="name">call.center.campaign.form.foundation</field>
    <field name="model">call.center.campaign</field>
    <field name="inherit_id" ref="view_campaign_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='business_unit_id']" position="after"><field name="branch_id"/></xpath>
      <xpath expr="//field[@name='calling_hour_end']" position="after"><field name="operating_calendar_id"/><field name="calling_hours_policy_id"/></xpath>
      <xpath expr="//field[@name='agent_ids']" position="before"><field name="authorized_user_ids" widget="many2many_tags"/></xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Country Policies"><field name="country_policy_ids"><list editable="bottom"><field name="country_id"/><field name="policy"/><field name="international_dialing_allowed"/><field name="calling_hours_policy_id"/><field name="phone_format_id"/><field name="consent_required"/><field name="dnc_enforced"/><field name="active"/></list></field></page>
        <page string="Managed Skills"><field name="skill_requirement_ids"><list editable="bottom"><field name="skill_id"/><field name="minimum_proficiency"/><field name="preferred_proficiency"/><field name="certification_required"/><field name="active"/></list></field></page>
        <page string="Queues"><field name="queue_ids" readonly="1"><list><field name="code"/><field name="name"/><field name="team_id"/><field name="direction"/><field name="queue_type"/><field name="reconciliation_state"/><field name="active"/></list></field></page>
      </xpath>
    </field>
  </record>

  <record id="view_queue_list" model="ir.ui.view"><field name="name">call.center.queue.list</field><field name="model">call.center.queue</field><field name="arch" type="xml"><list><field name="priority"/><field name="code"/><field name="name"/><field name="business_unit_id"/><field name="campaign_id"/><field name="team_id"/><field name="direction"/><field name="queue_type"/><field name="vicidial_queue_reference"/><field name="reconciliation_state"/><field name="active"/></list></field></record>
  <record id="view_queue_search" model="ir.ui.view"><field name="name">call.center.queue.search</field><field name="model">call.center.queue</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="business_unit_id"/><field name="campaign_id"/><field name="team_id"/><field name="branch_id"/><field name="vicidial_queue_reference"/><filter name="active" string="Active" domain="[('active', '=', True)]"/><group><filter name="unit" string="Business Unit" context="{'group_by': 'business_unit_id'}"/><filter name="campaign" string="Campaign" context="{'group_by': 'campaign_id'}"/><filter name="state" string="Reconciliation" context="{'group_by': 'reconciliation_state'}"/></group></search></field></record>
  <record id="view_queue_form" model="ir.ui.view"><field name="name">call.center.queue.form</field><field name="model">call.center.queue</field><field name="arch" type="xml"><form><sheet><group><group><field name="code"/><field name="name"/><field name="company_id"/><field name="business_unit_id"/><field name="branch_id"/><field name="active"/></group><group><field name="campaign_id"/><field name="team_id"/><field name="direction"/><field name="queue_type"/><field name="priority"/></group></group><notebook><page string="Service"><group><field name="service_level_seconds"/><field name="maximum_wait_seconds"/><field name="maximum_capacity"/><field name="overflow_queue_id"/><field name="fallback_destination"/><field name="allowed_role_codes"/></group></page><page string="Required Skills"><field name="skill_requirement_ids"><list editable="bottom"><field name="skill_id"/><field name="minimum_proficiency"/><field name="preferred_proficiency"/><field name="certification_required"/><field name="active"/></list></field></page><page string="External Mapping"><group><field name="vicidial_queue_reference"/><field name="external_id"/><field name="reconciliation_state"/><field name="last_reconciled_at"/><field name="reconciliation_evidence"/><field name="live_membership_authority"/></group></page><page string="Audit"><group><field name="audit_source_system"/><field name="audit_correlation_id"/><field name="audit_idempotency_key"/><field name="audit_reason"/><field name="audit_evidence_reference"/></group></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_queues" model="ir.actions.act_window"><field name="name">Queues</field><field name="res_model">call.center.queue</field><field name="view_mode">list,form</field></record>

  <record id="view_disposition_list" model="ir.ui.view"><field name="name">codestra.disposition.list</field><field name="model">codestra.disposition</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="category"/><field name="campaign_id"/><field name="vicidial_status_code"/><field name="canonical_status_id"/><field name="human_contact"/><field name="callback_required"/><field name="terminal"/><field name="active"/></list></field></record>
  <record id="view_disposition_search" model="ir.ui.view"><field name="name">codestra.disposition.search</field><field name="model">codestra.disposition</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="category"/><field name="campaign_id"/><field name="business_unit_id"/><field name="vicidial_status_code"/><group><filter name="campaign" string="Campaign" context="{'group_by': 'campaign_id'}"/><filter name="category" string="Category" context="{'group_by': 'category'}"/></group></search></field></record>
  <record id="view_disposition_form" model="ir.ui.view"><field name="name">codestra.disposition.form</field><field name="model">codestra.disposition</field><field name="arch" type="xml"><form><sheet><group><group><field name="code"/><field name="name"/><field name="category"/><field name="business_unit_id"/><field name="campaign_id"/><field name="active"/></group><group><field name="vicidial_status_code"/><field name="canonical_status_id"/><field name="human_contact"/><field name="attempt"/><field name="agent_visible"/><field name="terminal"/></group></group><notebook><page string="Requirements"><group><field name="note_required"/><field name="callback_required"/><field name="retry_interval_minutes"/><field name="maximum_retries"/><field name="supervisor_approval_required"/><field name="compliance_block"/></group></page><page string="CRM Stage Policy"><field name="stage_change_policy"/><field name="allowed_next_stage_ids" widget="many2many_tags"/></page><page string="Audit"><group><field name="audit_source_system"/><field name="audit_correlation_id"/><field name="audit_idempotency_key"/><field name="audit_reason"/><field name="audit_evidence_reference"/></group></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_dispositions" model="ir.actions.act_window"><field name="name">Dispositions</field><field name="res_model">codestra.disposition</field><field name="view_mode">list,form</field></record>
</odoo>
