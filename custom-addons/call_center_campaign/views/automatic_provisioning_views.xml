<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_campaign_list_automatic_provisioning" model="ir.ui.view">
    <field name="name">call.center.campaign.list.automatic.provisioning</field>
    <field name="model">call.center.campaign</field>
    <field name="inherit_id" ref="call_center_campaign.view_campaign_list"/>
    <field name="arch" type="xml">
      <xpath expr="//list/field[@name='state']" position="after">
        <field name="automatic_design_state"/>
        <field name="provisioning_environment"/>
      </xpath>
    </field>
  </record>

  <record id="view_campaign_form_automatic_provisioning" model="ir.ui.view">
    <field name="name">call.center.campaign.form.automatic.provisioning</field>
    <field name="model">call.center.campaign</field>
    <field name="inherit_id" ref="call_center_campaign.view_campaign_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form/header" position="inside">
        <button
          name="action_request_design_preview"
          type="object"
          string="Request / Refresh Design"
          groups="call_center_core.group_call_center_manager"
        />
        <button
          name="action_approve_design"
          type="object"
          string="Approve Design"
          class="btn-primary"
          groups="call_center_core.group_call_center_manager"
          invisible="automatic_design_state != 'ready'"
        />
      </xpath>
      <xpath expr="//form/sheet/notebook" position="inside">
        <page string="Automatic Provisioning">
          <group>
            <group string="Design Control">
              <field name="design_automation_enabled" readonly="1"/>
              <field name="automatic_design_managed" invisible="1"/>
              <field name="provisioning_environment"/>
              <field name="automatic_design_state" readonly="1"/>
              <field name="design_request_revision" readonly="1"/>
              <field name="design_request_state" readonly="1"/>
            </group>
            <group string="Immutable Identity">
              <field name="integration_uuid" readonly="1"/>
              <field name="design_manifest_hash" readonly="1"/>
              <field name="design_preview_received_at" readonly="1"/>
              <field name="last_approval_event_uuid" readonly="1"/>
            </group>
          </group>
          <group string="Required Design Inputs">
            <field
              name="design_input_json"
              placeholder="Add every required policy input from AUTOMATIC_CAMPAIGN_PROVISIONING.md"
            />
            <field
              name="design_validation_errors_json"
              readonly="1"
            />
            <field
              name="design_approval_reason"
              placeholder="Required audit reason before approval"
            />
          </group>
          <group string="Versioned Design History">
            <field name="design_revision_ids" readonly="1">
              <list create="0" edit="0" delete="0">
                <field name="revision"/>
                <field name="environment"/>
                <field name="state"/>
                <field name="manifest_schema_version"/>
                <field name="manifest_hash"/>
                <field name="requested_at"/>
                <field name="received_at"/>
                <field name="approved_by"/>
                <field name="approved_at"/>
              </list>
              <form create="0" edit="0" delete="0">
                <sheet>
                  <group>
                    <group>
                      <field name="revision"/>
                      <field name="state"/>
                      <field name="environment"/>
                      <field name="event_uuid"/>
                      <field name="request_payload_hash"/>
                    </group>
                    <group>
                      <field name="manifest_schema_version"/>
                      <field name="manifest_hash"/>
                      <field name="requested_at"/>
                      <field name="received_at"/>
                      <field name="approved_by"/>
                      <field name="approved_at"/>
                    </group>
                  </group>
                  <group string="Validation">
                    <field name="validation_errors_json"/>
                    <field name="approval_reason"/>
                  </group>
                  <group string="Canonical Middleware Preview">
                    <field name="manifest_json"/>
                  </group>
                </sheet>
              </form>
            </field>
          </group>
        </page>
      </xpath>
    </field>
  </record>
  <record id="action_campaigns" model="ir.actions.act_window">
    <field name="context">{
      'default_design_automation_enabled': True,
      'codestra_automatic_campaign_form': True
    }</field>
  </record>
</odoo>
