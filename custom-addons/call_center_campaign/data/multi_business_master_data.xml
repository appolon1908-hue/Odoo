  <!-- Pipelines are version-controlled metadata. Individual crm.stage records
       remain inactive until their stage-gate rules are installed and tested. -->
  <record id="pipeline_moy" model="call.center.pipeline"><field name="name">Moy Logistics Pipeline</field><field name="code">MOY-PRIMARY</field><field name="business_unit_id" ref="call_center_core.business_unit_transport"/><field name="stage_flow">New Lead → Validation → Carrier/Shipper Classification → AI Pre-Qualification → SDR Contact → Qualified → Quote → Closer → Proposal → Contract → Onboarding → Active Account → Retention → Upsell</field></record>
  <record id="pipeline_cod" model="call.center.pipeline"><field name="name">Codestra Pipeline</field><field name="code">COD-PRIMARY</field><field name="business_unit_id" ref="call_center_core.business_unit_digital"/><field name="stage_flow">New Lead → Enrichment → Technology Audit → AI Pre-Qualification → SDR Discovery → Discovery Appointment → Technical Discovery → Qualified → Technical Closer → Scope → Estimate → Proposal → Negotiation → Contract → Deposit → Project Handoff → Delivery → Maintenance → Renewal → Upsell</field></record>
  <record id="pipeline_scp" model="call.center.pipeline"><field name="name">Senior Citizen Products Pipeline</field><field name="code">SCP-PRIMARY</field><field name="business_unit_id" ref="call_center_core.business_unit_senior"/><field name="stage_flow">New Inquiry → Consent Verification → Validation → Product Interest → AI Pre-Qualification → Needs Assessment → Product Specialist → Closer → Order Confirmation → Payment → Fulfillment → Shipment → Delivery → Follow-Up → Reorder → Retention → Cross-Sell</field></record>
  <record id="pipeline_mbl" model="call.center.pipeline"><field name="name">MoneyBee Pipeline</field><field name="code">MBL-PRIMARY</field><field name="business_unit_id" ref="call_center_core.business_unit_moneybee"/><field name="stage_flow">New Lead → Business Validation → Consent Verification → AI Pre-Qualification → SDR Contact → Funding Assessment → Document Collection → Application → Underwriting → Offer → Closer → Contract → Funding → Renewal</field></record>
  <record id="pipeline_rlp" model="call.center.pipeline"><field name="name">RLP International Pipeline</field><field name="code">RLP-PRIMARY</field><field name="business_unit_id" ref="call_center_core.business_unit_rlp"/><field name="stage_flow">New Lead → Buyer/Seller/Investor Classification → Validation → AI Qualification → SDR Contact → Needs Assessment → Financial Qualification → Property Match → Appointment → Viewing → Offer → Negotiation → Contract → Closing → Follow-Up → Referral</field></record>
  <record id="pipeline_ftp" model="call.center.pipeline"><field name="name">For the People Pipeline</field><field name="code">FTP-PRIMARY</field><field name="business_unit_id" ref="call_center_core.business_unit_ftp"/><field name="stage_flow">New Donor Lead → Consent Validation → Donor Classification → AI Pre-Qualification → Fundraising Contact → Campaign Presentation → Donation Interest → Pledge → Confirmation → Payment → Receipt → Donor Onboarding → Retention → Upgrade</field></record>
  <record id="pipeline_trx" model="call.center.pipeline"><field name="name">TradeX Pipeline</field><field name="code">TRX-PRIMARY</field><field name="business_unit_id" ref="call_center_core.business_unit_tradex"/><field name="stage_flow">New Lead → Customer Classification → Consent and Suitability Review → AI Pre-Qualification → SDR Contact → Demo → Technical Discovery → Trial → Closer → Proposal → Contract → Payment → Onboarding → Activation → Support → Renewal → Upsell</field></record>
  <record id="pipeline_cal" model="call.center.pipeline"><field name="name">Calderon Farm Pipeline</field><field name="code">CAL-PRIMARY</field><field name="business_unit_id" ref="call_center_core.business_unit_calderon"/><field name="stage_flow">New Buyer or Partner → Classification → Validation → Product Interest → Quantity Requirement → Price Request → Sample or Inspection → Quotation → Negotiation → Purchase Order → Harvest Allocation → Packing → Delivery or Export → Invoice → Payment → Repeat Order → Renewal</field></record>

