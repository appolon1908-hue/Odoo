<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_campaign_design_revision_unit" model="ir.rule">
    <field name="name">Campaign design revisions in authorized campaign scope</field>
    <field name="model_id" ref="model_call_center_campaign_design_revision"/>
    <field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/>
    <field name="domain_force">[(1, '=', 1)] if user.has_group('call_center_core.group_call_center_admin') else [('business_unit_id', 'in', user.call_center_business_unit_ids.ids), ('campaign_id.authorized_user_ids', 'in', user.id)]</field>
  </record>
</odoo>
