<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_campaign_unit" model="ir.rule"><field name="name">Authorized campaigns in authorized business units</field><field name="model_id" ref="model_call_center_campaign"/><field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/><field name="domain_force">[(1, '=', 1)] if user.has_group('call_center_core.group_call_center_admin') else [('business_unit_id', 'in', user.call_center_business_unit_ids.ids), ('authorized_user_ids', 'in', user.id)]</field></record>
  <record id="rule_team_unit" model="ir.rule"><field name="name">Authorized teams in authorized business units</field><field name="model_id" ref="model_call_center_team"/><field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/><field name="domain_force">[(1, '=', 1)] if user.has_group('call_center_core.group_call_center_admin') else [('business_unit_id', 'in', user.call_center_business_unit_ids.ids), '|', ('manager_id', '=', user.id), '|', ('agent_ids', 'in', user.id), ('supervisor_ids', 'in', user.id)]</field></record>
  <record id="rule_script_unit" model="ir.rule"><field name="name">Scripts for authorized campaigns</field><field name="model_id" ref="model_call_center_script"/><field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/><field name="domain_force">[(1, '=', 1)] if user.has_group('call_center_core.group_call_center_admin') else [('business_unit_id', 'in', user.call_center_business_unit_ids.ids), ('campaign_id.authorized_user_ids', 'in', user.id)]</field></record>
  <record id="rule_pipeline_unit" model="ir.rule"><field name="name">Pipeline business units</field><field name="model_id" ref="model_call_center_pipeline"/><field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/><field name="domain_force">[('business_unit_id', 'in', user.call_center_business_unit_ids.ids)]</field></record>
  <record id="rule_crm_team_unit" model="ir.rule"><field name="name">CRM team business units</field><field name="model_id" ref="sales_team.model_crm_team"/><field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/><field name="domain_force">['|', ('business_unit_id', 'in', user.call_center_business_unit_ids.ids), ('shared_business_unit_ids', 'in', user.call_center_business_unit_ids.ids)]</field></record>
  <record id="rule_crm_lead_campaign" model="ir.rule"><field name="name">Role and campaign scoped CRM leads</field><field name="model_id" ref="crm.model_crm_lead"/><field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/><field name="domain_force">[(1,'=',1)] if user.has_group('call_center_core.group_call_center_admin') else ([('business_unit_id','in',user.call_center_business_unit_ids.ids)] if user.has_group('call_center_core.group_call_center_manager') else ([('call_center_campaign_id.supervisor_ids','in',user.id)] if user.has_group('call_center_core.group_call_center_supervisor') else (['&amp;',('call_center_campaign_id.authorized_user_ids','in',user.id),'|',('user_id','=',user.id),('assigned_agent_profile_id.user_id','=',user.id)])))</field></record>
  <record id="rule_campaign_mapping_unit" model="ir.rule"><field name="name">Campaign mappings in authorized business units and campaigns</field><field name="model_id" ref="model_call_center_campaign_mapping"/><field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/><field name="domain_force">[(1, '=', 1)] if user.has_group('call_center_core.group_call_center_admin') else [('business_unit_id', 'in', user.call_center_business_unit_ids.ids), ('campaign_id.authorized_user_ids', 'in', user.id)]</field></record>
  <record id="rule_queue_unit" model="ir.rule"><field name="name">Queues in authorized business units and campaigns</field><field name="model_id" ref="model_call_center_queue"/><field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/><field name="domain_force">[(1, '=', 1)] if user.has_group('call_center_core.group_call_center_admin') else [('business_unit_id', 'in', user.call_center_business_unit_ids.ids), ('campaign_id.authorized_user_ids', 'in', user.id)]</field></record>
  <record id="rule_skill_requirement_scope" model="ir.rule"><field name="name">Skill requirements in authorized campaign scope</field><field name="model_id" ref="model_call_center_skill_requirement"/><field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/><field name="domain_force">[(1, '=', 1)] if user.has_group('call_center_core.group_call_center_admin') else ['|', '&amp;', ('campaign_id', '!=', False), ('campaign_id.authorized_user_ids', 'in', user.id), '&amp;', ('queue_id', '!=', False), ('queue_id.campaign_id.authorized_user_ids', 'in', user.id)]</field></record>
  <record id="rule_country_policy_scope" model="ir.rule"><field name="name">Country policies in authorized campaign scope</field><field name="model_id" ref="model_call_center_campaign_country_policy"/><field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/><field name="domain_force">[(1, '=', 1)] if user.has_group('call_center_core.group_call_center_admin') else [('campaign_id.authorized_user_ids', 'in', user.id)]</field></record>
  <record id="rule_disposition_scope" model="ir.rule"><field name="name">Dispositions in authorized campaigns</field><field name="model_id" ref="model_codestra_disposition"/><field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/><field name="domain_force">[(1, '=', 1)] if user.has_group('call_center_core.group_call_center_admin') else [('business_unit_id', 'in', user.call_center_business_unit_ids.ids), ('campaign_id.authorized_user_ids', 'in', user.id)]</field></record>
</odoo>
