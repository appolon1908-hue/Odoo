<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_codestra_cc_shift_list" model="ir.ui.view">
    <field name="name">codestra.cc.shift.list</field>
    <field name="model">codestra.cc.shift</field>
    <field name="arch" type="xml">
      <list string="Agent Shifts" default_order="start_at desc">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="agent_id"/>
        <field name="start_at"/>
        <field name="end_at"/>
        <field name="planned_hours"/>
        <field name="actual_hours"/>
        <field name="adherence_percent"/>
        <field name="state"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>

  <record id="view_codestra_cc_shift_form" model="ir.ui.view">
    <field name="name">codestra.cc.shift.form</field>
    <field name="model">codestra.cc.shift</field>
    <field name="arch" type="xml">
      <form string="Agent Shift">
        <header>
          <button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state != 'published'"/>
          <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'published')"/>
          <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state not in ('published', 'cancelled')"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,published,completed,cancelled"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="employee_id"/>
              <field name="agent_id"/>
              <field name="resource_calendar_id"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
            <group>
              <field name="start_at"/>
              <field name="end_at"/>
              <field name="timezone"/>
              <field name="break_minutes"/>
            </group>
          </group>
          <group string="Attendance and adherence">
            <field name="attendance_id"/>
            <field name="planned_hours" readonly="1"/>
            <field name="actual_hours" readonly="1"/>
            <field name="adherence_percent" readonly="1"/>
          </group>
          <field name="notes"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_codestra_cc_shifts" model="ir.actions.act_window">
    <field name="name">Agent Shifts</field>
    <field name="res_model">codestra.cc.shift</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_codestra_cc_shifts" name="Workforce" parent="call_center_core.menu_call_center_root" action="action_codestra_cc_shifts" sequence="75" groups="call_center_core.group_call_center_user"/>
</odoo>
