<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_crm_lead_form_call_center" model="ir.ui.view">
    <field name="name">crm.lead.form.call.center</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='user_id']" position="after">
        <field name="business_unit_id" groups="call_center_core.group_call_center_user"/>
        <field name="assigned_closer_id" groups="call_center_core.group_call_center_closer"/>
      </xpath>
    </field>
  </record>
</odoo>
