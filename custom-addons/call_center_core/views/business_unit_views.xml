<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_business_unit_list" model="ir.ui.view">
    <field name="name">call.center.business.unit.list</field>
    <field name="model">call.center.business.unit</field>
    <field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="manager_id"/><field name="timezone"/><field name="active"/></list></field>
  </record>
  <record id="view_business_unit_form" model="ir.ui.view">
    <field name="name">call.center.business.unit.form</field>
    <field name="model">call.center.business.unit</field>
    <field name="arch" type="xml">
      <form><sheet><group><field name="name"/><field name="code"/><field name="company_id"/><field name="manager_id"/><field name="timezone"/><field name="active"/></group><field name="department_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="manager_id"/></list></field></sheet><chatter/></form>
    </field>
  </record>
  <record id="action_business_units" model="ir.actions.act_window">
    <field name="name">Business Units</field><field name="res_model">call.center.business.unit</field><field name="view_mode">list,form</field>
  </record>
</odoo>
