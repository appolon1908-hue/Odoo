<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_branch_list" model="ir.ui.view"><field name="name">call.center.branch.list</field><field name="model">call.center.branch</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="company_id"/><field name="country_id"/><field name="timezone"/><field name="business_unit_ids" widget="many2many_tags"/><field name="active"/></list></field></record>
  <record id="view_branch_search" model="ir.ui.view"><field name="name">call.center.branch.search</field><field name="model">call.center.branch</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="company_id"/><field name="country_id"/><field name="business_unit_ids"/><filter name="active" string="Active" domain="[('active', '=', True)]"/><group><filter name="company" string="Company" context="{'group_by': 'company_id'}"/><filter name="country" string="Country" context="{'group_by': 'country_id'}"/></group></search></field></record>
  <record id="view_branch_form" model="ir.ui.view"><field name="name">call.center.branch.form</field><field name="model">call.center.branch</field><field name="arch" type="xml"><form><sheet><group><group><field name="code"/><field name="name"/><field name="company_id"/><field name="active"/></group><group><field name="country_id"/><field name="state_id"/><field name="timezone"/></group></group><group string="Address"><field name="street"/><field name="street2"/><field name="city"/><field name="zip"/></group><notebook><page string="Scope"><field name="business_unit_ids" widget="many2many_tags"/></page><page string="Operating Policy"><field name="operating_calendar_id"/><field name="calling_hours_policy_id"/></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_branches" model="ir.actions.act_window"><field name="name">Branches</field><field name="res_model">call.center.branch</field><field name="view_mode">list,form</field></record>

  <record id="view_calling_policy_list" model="ir.ui.view"><field name="name">call.center.calling.hours.policy.list</field><field name="model">call.center.calling.hours.policy</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="company_id"/><field name="timezone"/><field name="effective_from"/><field name="effective_to"/><field name="active"/></list></field></record>
  <record id="view_calling_policy_search" model="ir.ui.view"><field name="name">call.center.calling.hours.policy.search</field><field name="model">call.center.calling.hours.policy</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="company_id"/><field name="country_ids"/><filter name="active" string="Active" domain="[('active', '=', True)]"/></search></field></record>
  <record id="view_calling_policy_form" model="ir.ui.view"><field name="name">call.center.calling.hours.policy.form</field><field name="model">call.center.calling.hours.policy</field><field name="arch" type="xml"><form><sheet><group><group><field name="code"/><field name="name"/><field name="company_id"/><field name="active"/></group><group><field name="timezone"/><field name="effective_from"/><field name="effective_to"/><field name="resource_calendar_id"/><field name="supervisor_override_allowed"/></group></group><field name="country_ids" widget="many2many_tags"/><notebook><page string="Operating Periods"><field name="period_ids"><list editable="bottom"><field name="weekday"/><field name="hour_from" widget="float_time"/><field name="hour_to" widget="float_time"/><field name="overnight"/></list></field></page><page string="Holidays and Exceptions"><field name="exception_ids"><list editable="bottom"><field name="name"/><field name="date_from"/><field name="date_to"/><field name="exception_type"/><field name="hour_from" widget="float_time"/><field name="hour_to" widget="float_time"/><field name="reason"/></list></field></page><page string="Audit Metadata"><group><field name="audit_source_system"/><field name="audit_correlation_id"/><field name="audit_idempotency_key"/><field name="audit_reason"/><field name="audit_evidence_reference"/></group></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_calling_policies" model="ir.actions.act_window"><field name="name">Calling-Hours Policies</field><field name="res_model">call.center.calling.hours.policy</field><field name="view_mode">list,form</field></record>
  <record id="action_operating_calendars" model="ir.actions.act_window"><field name="name">Operating Calendars</field><field name="res_model">resource.calendar</field><field name="view_mode">list,form</field></record>

  <record id="view_phone_format_list" model="ir.ui.view"><field name="name">call.center.phone.format.list</field><field name="model">call.center.phone.format</field><field name="arch" type="xml"><list><field name="country_id"/><field name="country_calling_code"/><field name="national_lengths"/><field name="permitted_prefixes"/><field name="active"/></list></field></record>
  <record id="view_phone_format_search" model="ir.ui.view"><field name="name">call.center.phone.format.search</field><field name="model">call.center.phone.format</field><field name="arch" type="xml"><search><field name="name"/><field name="country_id"/><field name="country_calling_code"/><filter name="active" string="Active" domain="[('active', '=', True)]"/></search></field></record>
  <record id="view_phone_format_form" model="ir.ui.view"><field name="name">call.center.phone.format.form</field><field name="model">call.center.phone.format</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="country_id"/><field name="country_calling_code"/><field name="trunk_prefix"/><field name="active"/></group><group><field name="national_lengths"/><field name="permitted_prefixes"/><field name="mobile_prefixes"/><field name="landline_prefixes"/><field name="strip_non_digits"/></group></group></sheet></form></field></record>
  <record id="action_phone_formats" model="ir.actions.act_window"><field name="name">Countries and Phone Formats</field><field name="res_model">call.center.phone.format</field><field name="view_mode">list,form</field></record>

  <record id="view_skill_list" model="ir.ui.view"><field name="name">call.center.skill.list</field><field name="model">call.center.skill</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="category_id"/><field name="skill_type"/><field name="active"/></list></field></record>
  <record id="view_skill_search" model="ir.ui.view"><field name="name">call.center.skill.search</field><field name="model">call.center.skill</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="category_id"/><field name="skill_type"/><group><filter name="category" string="Category" context="{'group_by': 'category_id'}"/><filter name="type" string="Type" context="{'group_by': 'skill_type'}"/></group></search></field></record>
  <record id="view_skill_form" model="ir.ui.view"><field name="name">call.center.skill.form</field><field name="model">call.center.skill</field><field name="arch" type="xml"><form><sheet><group><field name="code"/><field name="name"/><field name="category_id"/><field name="skill_type"/><field name="active"/></group></sheet></form></field></record>
  <record id="action_skills" model="ir.actions.act_window"><field name="name">Skills</field><field name="res_model">call.center.skill</field><field name="view_mode">list,form</field></record>

  <record id="view_canonical_status_list" model="ir.ui.view"><field name="name">call.center.canonical.status.list</field><field name="model">call.center.canonical.status</field><field name="arch" type="xml"><list><field name="layer"/><field name="code"/><field name="name"/><field name="category"/><field name="terminal"/><field name="active"/></list></field></record>
  <record id="view_canonical_status_search" model="ir.ui.view"><field name="name">call.center.canonical.status.search</field><field name="model">call.center.canonical.status</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="layer"/><field name="category"/><group><filter name="layer" string="Layer" context="{'group_by': 'layer'}"/></group></search></field></record>
  <record id="view_canonical_status_form" model="ir.ui.view"><field name="name">call.center.canonical.status.form</field><field name="model">call.center.canonical.status</field><field name="arch" type="xml"><form><sheet><group><field name="layer"/><field name="code"/><field name="name"/><field name="category"/><field name="sequence"/><field name="terminal"/><field name="active"/></group><field name="description"/></sheet></form></field></record>
  <record id="action_canonical_statuses" model="ir.actions.act_window"><field name="name">Canonical Statuses</field><field name="res_model">call.center.canonical.status</field><field name="view_mode">list,form</field></record>
