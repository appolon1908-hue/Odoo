<odoo noupdate="1">
  <record id="stage_new" model="crm.stage"><field name="name">R1 New</field><field name="sequence">10</field><field name="canonical_journey_status_id" ref="call_center_core.status_journey_new"/></record>
  <record id="stage_validated" model="crm.stage"><field name="name">R1 Consent and Validation</field><field name="sequence">20</field><field name="canonical_journey_status_id" ref="call_center_core.status_journey_validation"/></record>
  <record id="stage_assigned" model="crm.stage"><field name="name">R1 Assigned</field><field name="sequence">30</field><field name="canonical_journey_status_id" ref="call_center_core.status_journey_qualification"/></record>
  <record id="stage_callback" model="crm.stage"><field name="name">R1 Callback Scheduled</field><field name="sequence">40</field><field name="canonical_journey_status_id" ref="call_center_core.status_journey_engaged"/></record>
  <record id="stage_appointment" model="crm.stage"><field name="name">R1 Appointment</field><field name="sequence">50</field><field name="canonical_journey_status_id" ref="call_center_core.status_journey_engaged"/></record>
  <record id="stage_won" model="crm.stage"><field name="name">R1 Successful</field><field name="sequence">80</field><field name="is_won" eval="True"/><field name="canonical_journey_status_id" ref="call_center_core.status_journey_converted"/></record>
  <record id="stage_lost" model="crm.stage"><field name="name">R1 Closed / Lost</field><field name="sequence">90</field><field name="fold" eval="True"/><field name="canonical_journey_status_id" ref="call_center_core.status_journey_blocked"/></record>
  <record id="stage_compliance" model="crm.stage"><field name="name">R1 Compliance Blocked</field><field name="sequence">95</field><field name="fold" eval="True"/><field name="canonical_journey_status_id" ref="call_center_core.status_journey_blocked"/></record>
</odoo>
