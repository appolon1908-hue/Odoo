<odoo>
  <record id="rule_campaign_design_scope" model="ir.rule">
    <field name="name">Campaign designs in authorized business units</field>
    <field name="model_id" ref="model_codestra_campaign_design_profile"/>
    <field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/>
    <field name="domain_force">[(1,'=',1)] if user.has_group('call_center_core.group_call_center_admin') else [('business_unit_id','in',user.call_center_business_unit_ids.ids)]</field>
  </record>
  <record id="rule_campaign_lead_scope" model="ir.rule">
    <field name="name">Campaign leads in authorized business units</field>
    <field name="model_id" ref="crm.model_crm_lead"/>
    <field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/>
    <field name="domain_force">[(1,'=',1)] if user.has_group('call_center_core.group_call_center_admin') else [('call_center_business_unit_id','in',user.call_center_business_unit_ids.ids)]</field>
  </record>
</odoo>
