<odoo>
    <record id="view_conversation_list" model="ir.ui.view">
        <field name="name">codestra.mail.conversation.list</field>
        <field name="model">codestra.mail.conversation</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="brand_id"/><field name="queue_type_id"/><field name="stage_id"/><field name="user_id"/><field name="first_response_due"/></list></field>
    </record>
    <record id="view_conversation_form" model="ir.ui.view">
        <field name="name">codestra.mail.conversation.form</field>
        <field name="model">codestra.mail.conversation</field>
        <field name="arch" type="xml">
            <form string="Shared Inbox Conversation">
                <sheet><group><field name="name"/><field name="team_id"/><field name="brand_id" readonly="1"/><field name="queue_type_id" readonly="1"/><field name="stage_id"/><field name="user_id"/><field name="sender"/><field name="recipient" readonly="1"/><field name="correlation_id" readonly="1"/></group></sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_team_list" model="ir.ui.view">
        <field name="name">codestra.mail.team.list</field><field name="model">codestra.mail.team</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="brand_id"/><field name="queue_type_id"/><field name="alias_full_name"/><field name="external_delivery_enabled"/></list></field>
    </record>
    <record id="view_team_form" model="ir.ui.view">
        <field name="name">codestra.mail.team.form</field><field name="model">codestra.mail.team</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="brand_id"/><field name="queue_type_id"/><field name="alias_name"/><field name="alias_domain_id"/><field name="member_ids" widget="many2many_tags"/><field name="manager_ids" widget="many2many_tags"/><field name="auditor_ids" widget="many2many_tags"/><field name="external_delivery_enabled"/></group></sheet><chatter/></form></field>
    </record>
    <record id="action_conversations" model="ir.actions.act_window"><field name="name">Conversations</field><field name="res_model">codestra.mail.conversation</field><field name="view_mode">list,form</field></record>
    <record id="action_teams" model="ir.actions.act_window"><field name="name">Inbox Teams</field><field name="res_model">codestra.mail.team</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_codestra_mail_root" name="Shared Inbox" sequence="40" groups="group_mail_support_user,group_mail_admin_user,group_mail_auditor"/>
    <menuitem id="menu_codestra_mail_conversations" name="Conversations" parent="menu_codestra_mail_root" action="action_conversations" sequence="10"/>
    <menuitem id="menu_codestra_mail_teams" name="Teams" parent="menu_codestra_mail_root" action="action_teams" sequence="20" groups="group_mail_support_manager,group_mail_admin_manager"/>
</odoo>
