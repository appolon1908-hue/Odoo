<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.codestra.orbit</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app string="Codestra Orbit" name="codestra_orbit_theme" groups="base.group_system">
          <block title="Keycloak single sign-on">
            <setting string="Issuer" help="HTTPS realm URL; do not include an endpoint suffix.">
              <field name="codestra_keycloak_issuer" placeholder="https://identity.example/realms/codestra"/>
            </setting>
            <setting string="Client ID"><field name="codestra_keycloak_client_id"/></setting>
            <setting string="Client secret"><field name="codestra_keycloak_client_secret" widget="password"/></setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
