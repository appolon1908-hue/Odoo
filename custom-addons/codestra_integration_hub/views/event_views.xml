<odoo>
  <record id="view_integration_event_list" model="ir.ui.view"><field name="name">codestra.integration.event.list.hub</field><field name="model">codestra.integration.event</field><field name="arch" type="xml"><list create="false" delete="false"><field name="name"/><field name="event_type"/><field name="source"/><field name="destination"/><field name="state"/><field name="attempt_count"/><field name="next_retry_at"/><field name="correlation_id"/></list></field></record>
  <record id="view_integration_event_form" model="ir.ui.view"><field name="name">codestra.integration.event.form.hub</field><field name="model">codestra.integration.event</field><field name="arch" type="xml"><form create="false" delete="false"><sheet><group><group><field name="name"/><field name="event_uuid"/><field name="event_type"/><field name="state"/></group><group><field name="source"/><field name="destination"/><field name="correlation_id"/><field name="causation_id"/></group></group><group><field name="attempt_count"/><field name="max_attempts"/><field name="next_retry_at"/><field name="last_error_code"/></group><notebook><page string="Redacted Payload"><field name="payload_redacted" readonly="1" nolabel="1"/></page><page string="Delivery Attempts"><field name="delivery_ids" readonly="1"/></page></notebook></sheet></form></field></record>
  <record id="view_integration_event_search" model="ir.ui.view"><field name="name">codestra.integration.event.search.hub</field><field name="model">codestra.integration.event</field><field name="arch" type="xml"><search><field name="name"/><field name="event_type"/><field name="correlation_id"/><filter name="retry" string="Retry Queue" domain="[('state','=','retry')]"/><group><filter name="group_state" string="State" context="{'group_by':'state'}"/><filter name="group_type" string="Event Type" context="{'group_by':'event_type'}"/></group></search></field></record>
  <record id="action_integration_events" model="ir.actions.act_window"><field name="name">Integration Events</field><field name="res_model">codestra.integration.event</field><field name="view_mode">list,form,pivot,graph</field><field name="search_view_id" ref="view_integration_event_search"/></record>
  <record id="action_integration_retry_queue" model="ir.actions.act_window"><field name="name">Retry Queue</field><field name="res_model">codestra.integration.event</field><field name="view_mode">list,form</field><field name="domain">[('state','=','retry')]</field></record>
</odoo>
