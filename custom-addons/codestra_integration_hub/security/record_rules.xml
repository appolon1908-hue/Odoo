<odoo>
  <record id="rule_hub_event_manager_read" model="ir.rule">
    <field name="name">Integration events: manager read</field>
    <field name="model_id" ref="codestra_vicidial_crm.model_codestra_integration_event"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[Command.link(ref('codestra_base.group_codestra_manager'))]"/>
    <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
  </record>
  <record id="rule_hub_admin_all_events" model="ir.rule">
    <field name="name">Integration events: administrator</field>
    <field name="model_id" ref="codestra_vicidial_crm.model_codestra_integration_event"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[Command.link(ref('codestra_base.group_codestra_integration_admin'))]"/>
  </record>
</odoo>
