<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_codestra_client_contract_list" model="ir.ui.view">
    <field name="name">codestra.client.contract.list</field>
    <field name="model">codestra.client.contract</field>
    <field name="arch" type="xml">
      <list string="Client Contracts" default_order="name, version desc">
        <field name="name"/>
        <field name="version"/>
        <field name="client_id"/>
        <field name="billing_model"/>
        <field name="start_date"/>
        <field name="end_date"/>
        <field name="state"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>

  <record id="view_codestra_client_contract_form" model="ir.ui.view">
    <field name="name">codestra.client.contract.form</field>
    <field name="model">codestra.client.contract</field>
    <field name="arch" type="xml">
      <form string="Client Contract">
        <header>
          <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'in_review'"/>
          <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'approved'"/>
          <button name="action_suspend" type="object" string="Suspend" invisible="state != 'active'"/>
          <button name="action_resume" type="object" string="Resume" invisible="state != 'suspended'"/>
          <button name="action_terminate" type="object" string="Terminate" invisible="state not in ('approved', 'active', 'suspended')"/>
          <button name="action_create_version" type="object" string="Create New Version" invisible="state not in ('approved', 'active', 'suspended')"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,in_review,approved,active,suspended,expired,terminated"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/> <span>v</span><field name="version"/></h1>
          </div>
          <group>
            <group>
              <field name="client_id"/>
              <field name="authorized_contact_ids" widget="many2many_tags"/>
              <field name="campaign_ids" widget="many2many_tags"/>
              <field name="predecessor_id" readonly="1"/>
            </group>
            <group>
              <field name="billing_model"/>
              <field name="currency_id"/>
              <field name="start_date"/>
              <field name="end_date"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </group>
          <notebook>
            <page string="Service Scope">
              <field name="service_scope"/>
            </page>
            <page string="SLAs">
              <field name="sla_ids">
                <list editable="bottom">
                  <field name="metric_code"/>
                  <field name="name"/>
                  <field name="operator"/>
                  <field name="target_value"/>
                  <field name="warning_value"/>
                  <field name="unit"/>
                  <field name="active"/>
                </list>
              </field>
            </page>
            <page string="Approval">
              <group>
                <field name="approval_user_id" readonly="1"/>
                <field name="approved_at" readonly="1"/>
                <field name="activated_at" readonly="1"/>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_codestra_client_contracts" model="ir.actions.act_window">
    <field name="name">Client Contracts</field>
    <field name="res_model">codestra.client.contract</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_codestra_client_contracts" name="Client Operations" parent="call_center_core.menu_call_center_root" action="action_codestra_client_contracts" sequence="78" groups="codestra_client_operations.group_codestra_client_operations_manager"/>
</odoo>
