<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_codestra_client_contract_company" model="ir.rule">
    <field name="name">Client contracts by allowed company</field>
    <field name="model_id" ref="model_codestra_client_contract"/>
    <field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_codestra_client_sla_company" model="ir.rule">
    <field name="name">Client SLAs by allowed company</field>
    <field name="model_id" ref="model_codestra_client_sla"/>
    <field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
