<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_cc_recording_list" model="ir.ui.view">
    <field name="name">cc.recording.list</field>
    <field name="model">cc.recording</field>
    <field name="arch" type="xml">
      <list create="0" delete="0" edit="0">
        <field name="recording_uid"/>
        <field name="campaign_id"/>
        <field name="source_call_unique_id"/>
        <field name="agent_membership_id"/>
        <field name="storage_state"/>
        <field name="redaction_state"/>
        <field name="retention_until"/>
        <field name="legal_hold"/>
      </list>
    </field>
  </record>
  <record id="view_cc_recording_form" model="ir.ui.view">
    <field name="name">cc.recording.form</field>
    <field name="model">cc.recording</field>
    <field name="arch" type="xml">
      <form create="0" delete="0" edit="0">
        <sheet>
          <group>
            <field name="recording_uid"/>
            <field name="campaign_id"/>
            <field name="source_call_unique_id"/>
            <field name="agent_membership_id"/>
            <field name="customer_profile_id"/>
            <field name="policy_id"/>
            <field name="storage_state"/>
            <field name="verification_state"/>
            <field name="redaction_state"/>
            <field name="retention_until"/>
            <field name="legal_hold"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_cc_recordings" model="ir.actions.act_window">
    <field name="name">Campaign Recordings</field>
    <field name="res_model">cc.recording</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
