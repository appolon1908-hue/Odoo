<odoo>
  <record id="crm_lead_view_form_codestra_marketing" model="ir.ui.view">
    <field name="name">crm.lead.form.codestra.marketing</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Codestra Attribution" groups="sales_team.group_sale_manager">
          <group>
            <group>
              <field name="codestra_marketing_tenant_id" readonly="1"/>
              <field name="codestra_marketing_lead_id" readonly="1"/>
              <field name="codestra_provider" readonly="1"/>
              <field name="codestra_provider_campaign_id" readonly="1"/>
              <field name="codestra_provider_adset_id" readonly="1"/>
              <field name="codestra_provider_ad_id" readonly="1"/>
            </group>
            <group>
              <field name="codestra_click_id" readonly="1"/>
              <field name="codestra_landing_page" readonly="1"/>
              <field name="codestra_first_touch_at" readonly="1"/>
              <field name="codestra_last_touch_at" readonly="1"/>
              <field name="codestra_conversion_status" readonly="1"/>
              <field name="codestra_conversion_synced_at" readonly="1"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
