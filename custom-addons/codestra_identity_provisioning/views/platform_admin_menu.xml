<odoo>
  <!-- codestra.extension.assignment ("Phone Assignments") had no standalone
       list/form action before - it was only ever reachable as a related
       field. codestra.provisioning.audit ("Provisioning Audit") likewise.
       Both are existing models; only the view/action is new here. -->
  <record id="view_extension_assignment_list" model="ir.ui.view">
    <field name="name">codestra.extension.assignment.list</field>
    <field name="model">codestra.extension.assignment</field>
    <field name="arch" type="xml">
      <list>
        <field name="extension"/>
        <field name="environment"/>
        <field name="employee_id"/>
        <field name="platform_user_id"/>
        <field name="vicidial_user"/>
        <field name="pool_id"/>
        <field name="state" widget="badge"
               decoration-success="state == 'committed'"
               decoration-warning="state == 'reserved'"
               decoration-muted="state in ('released', 'expired')"/>
        <field name="incoming_allowed" widget="boolean_toggle"/>
        <field name="outgoing_allowed" widget="boolean_toggle"/>
        <field name="webrtc_enabled" widget="boolean_toggle"/>
        <field name="reserved_at"/>
        <field name="committed_at"/>
      </list>
    </field>
  </record>
  <record id="view_extension_assignment_form" model="ir.ui.view">
    <field name="name">codestra.extension.assignment.form</field>
    <field name="model">codestra.extension.assignment</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="extension"/>
              <field name="environment"/>
              <field name="pool_id"/>
            </group>
            <group>
              <field name="employee_id"/>
              <field name="platform_user_id"/>
              <field name="request_id"/>
              <field name="vicidial_user"/>
              <field name="provider_reference" readonly="1"/>
            </group>
          </group>
          <group string="Telephony Policy">
            <field name="incoming_allowed" widget="boolean_toggle"/>
            <field name="outgoing_allowed" widget="boolean_toggle"/>
            <field name="webrtc_enabled" widget="boolean_toggle"/>
            <field name="max_webrtc_endpoints" readonly="1"/>
            <field name="max_active_sessions" readonly="1"/>
            <field name="active_session_reference" readonly="1"/>
            <field name="active_browser_reference" readonly="1"/>
          </group>
          <group string="Lifecycle">
            <field name="reserved_at" readonly="1"/>
            <field name="expires_at" readonly="1"/>
            <field name="committed_at" readonly="1"/>
            <field name="released_at" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_extension_assignments" model="ir.actions.act_window">
    <field name="name">Phone Assignments</field>
    <field name="res_model">codestra.extension.assignment</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_provisioning_audit_list" model="ir.ui.view">
    <field name="name">codestra.provisioning.audit.list</field>
    <field name="model">codestra.provisioning.audit</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0">
        <field name="timestamp"/>
        <field name="request_id"/>
        <field name="event_type"/>
        <field name="actor_id"/>
        <field name="actor_system"/>
        <field name="result"/>
        <field name="correlation_id"/>
        <field name="evidence_hash"/>
      </list>
    </field>
  </record>
  <record id="action_provisioning_audit" model="ir.actions.act_window">
    <field name="name">Provisioning Audit</field>
    <field name="res_model">codestra.provisioning.audit</field>
    <field name="view_mode">list</field>
  </record>

  <!-- Platform Administration: a single, curated entry point over models
       that mostly already exist and already have their own actions
       elsewhere (cc.campaign, cc.campaign.membership) - reused here, not
       redefined, so there is exactly one action per model. -->
  <menuitem id="menu_platform_administration_root" name="Platform Administration"
            groups="codestra_identity_provisioning.group_provisioning_user"
            sequence="5"/>
  <menuitem id="menu_platform_admin_tenants" name="Tenants"
            parent="menu_platform_administration_root"
            action="action_tenants" sequence="10"/>
  <menuitem id="menu_platform_admin_campaigns" name="Campaigns"
            parent="menu_platform_administration_root"
            action="codestra_cc_core.action_cc_campaigns" sequence="20"/>
  <menuitem id="menu_platform_admin_platform_users" name="Platform Users"
            parent="menu_platform_administration_root"
            action="action_platform_users" sequence="30"/>
  <menuitem id="menu_platform_admin_agent_accounts" name="Agent Accounts"
            parent="menu_platform_administration_root"
            action="codestra_cc_security.action_cc_campaign_membership" sequence="40"/>
  <menuitem id="menu_platform_admin_channel_access" name="Channel Access"
            parent="menu_platform_administration_root"
            action="action_agent_channels" sequence="50"/>
  <menuitem id="menu_platform_admin_phone_assignments" name="Phone Assignments"
            parent="menu_platform_administration_root"
            action="action_extension_assignments" sequence="60"/>
  <menuitem id="menu_platform_admin_provisioning_requests" name="Provisioning Requests"
            parent="menu_platform_administration_root"
            action="action_provisioning_requests" sequence="70"/>
  <menuitem id="menu_platform_admin_provisioning_audit" name="Provisioning Audit"
            parent="menu_platform_administration_root"
            action="action_provisioning_audit" sequence="80"/>
</odoo>
