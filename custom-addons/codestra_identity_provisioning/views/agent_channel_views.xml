<odoo>
  <record id="view_agent_channel_list" model="ir.ui.view">
    <field name="name">codestra.agent.channel.list</field>
    <field name="model">codestra.agent.channel</field>
    <field name="arch" type="xml">
      <list>
        <field name="employee_id"/>
        <field name="channel_type"/>
        <field name="desired_enabled"/>
        <field name="state" widget="badge"
               decoration-success="state == 'effective'"
               decoration-danger="state == 'failed'"
               decoration-warning="state in ('requested', 'provisioning', 'provisioned')"
               decoration-muted="state == 'revoked'"/>
        <field name="effective_access"/>
        <field name="incoming_allowed"/>
        <field name="outgoing_allowed"/>
        <field name="campaign_id"/>
        <field name="supervisor_id"/>
        <field name="extension"/>
        <field name="last_reconciled_at"/>
      </list>
    </field>
  </record>
  <record id="view_agent_channel_form" model="ir.ui.view">
    <field name="name">codestra.agent.channel.form</field>
    <field name="model">codestra.agent.channel</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="employee_id"/>
              <field name="channel_type"/>
              <field name="membership_id"/>
              <field name="provisioning_request_id"/>
              <field name="correlation_id"/>
            </group>
            <group>
              <field name="campaign_id" readonly="1"/>
              <field name="business_unit_id" readonly="1"/>
              <field name="supervisor_id" readonly="1"/>
              <field name="extension_assignment_id"/>
              <field name="extension" readonly="1"/>
            </group>
          </group>
          <group string="Provisioning Intent">
            <field name="desired_enabled"/>
            <field name="incoming_allowed"/>
            <field name="outgoing_allowed"/>
            <field name="effective_access" readonly="1"/>
          </group>
          <group string="External Status"
                 groups="codestra_identity_provisioning.group_provisioning_global_super_admin,codestra_identity_provisioning.group_provisioning_service">
            <field name="external_system"/>
            <field name="external_id"/>
            <field name="external_reference"/>
            <field name="last_reconciled_at"/>
            <field name="last_error_code"/>
            <field name="last_error_sanitized"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_agent_channels" model="ir.actions.act_window">
    <field name="name">Agent Channels</field>
    <field name="res_model">codestra.agent.channel</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_agent_channels" name="Agent Channels"
            parent="menu_identity_provisioning_root"
            action="action_agent_channels"/>
</odoo>
