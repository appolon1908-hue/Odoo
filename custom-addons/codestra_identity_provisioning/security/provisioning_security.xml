<odoo>
  <record id="module_category_identity_provisioning" model="ir.module.category">
    <field name="name">Identity Provisioning</field>
  </record>
  <record id="privilege_identity_provisioning" model="res.groups.privilege">
    <field name="name">Identity Provisioning</field>
    <field name="category_id" ref="module_category_identity_provisioning"/>
  </record>
  <record id="group_provisioning_user" model="res.groups">
    <field name="name">Provisioning User</field>
    <field name="privilege_id" ref="privilege_identity_provisioning"/>
    <field name="sequence">10</field>
  </record>
  <record id="group_provisioning_approver" model="res.groups">
    <field name="name">Provisioning Approver</field>
    <field name="implied_ids" eval="[(4, ref('group_provisioning_user'))]"/>
    <field name="privilege_id" ref="privilege_identity_provisioning"/>
    <field name="sequence">20</field>
  </record>
  <record id="group_provisioning_security_admin" model="res.groups">
    <field name="name">Provisioning Security Administrator</field>
    <field name="implied_ids" eval="[(4, ref('group_provisioning_approver'))]"/>
    <field name="privilege_id" ref="privilege_identity_provisioning"/>
    <field name="sequence">30</field>
  </record>
  <record id="group_provisioning_service" model="res.groups">
    <field name="name">Provisioning Integration Service</field>
    <field name="privilege_id" ref="privilege_identity_provisioning"/>
    <field name="sequence">40</field>
  </record>
  <record id="rule_request_scope" model="ir.rule">
    <field name="name">Provisioning request company, unit and ownership scope</field>
    <field name="model_id" ref="model_codestra_provisioning_request"/>
    <field name="groups" eval="[(4, ref('group_provisioning_user'))]"/>
    <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', '|', '|', ('business_unit_id', 'in', user.call_center_business_unit_ids.ids), ('requested_by', '=', user.id), ('supervisor_id', '=', user.id), ('approval_owner_id', '=', user.id)]</field>
  </record>
  <record id="rule_step_scope" model="ir.rule">
    <field name="name">Provisioning step request scope</field>
    <field name="model_id" ref="model_codestra_provisioning_step"/>
    <field name="groups" eval="[(4, ref('group_provisioning_user'))]"/>
    <field name="domain_force">[('request_id.business_unit_id', 'in', user.call_center_business_unit_ids.ids)]</field>
  </record>
  <record id="rule_identity_scope" model="ir.rule">
    <field name="name">Identity link business-unit scope</field>
    <field name="model_id" ref="model_codestra_identity_link"/>
    <field name="groups" eval="[(4, ref('group_provisioning_user'))]"/>
    <field name="domain_force">[('business_unit_id', 'in', user.call_center_business_unit_ids.ids)]</field>
  </record>
  <record id="rule_role_scope" model="ir.rule">
    <field name="name">Role template company and business-unit scope</field>
    <field name="model_id" ref="model_codestra_role_template"/>
    <field name="groups" eval="[(4, ref('group_provisioning_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids), ('business_unit_id', 'in', user.call_center_business_unit_ids.ids)]</field>
  </record>
  <record id="rule_pool_scope" model="ir.rule">
    <field name="name">Extension pool business-unit scope</field>
    <field name="model_id" ref="model_codestra_extension_pool"/>
    <field name="groups" eval="[(4, ref('group_provisioning_user'))]"/>
    <field name="domain_force">[('business_unit_id', 'in', user.call_center_business_unit_ids.ids)]</field>
  </record>
  <record id="rule_assignment_scope" model="ir.rule">
    <field name="name">Extension assignment business-unit scope</field>
    <field name="model_id" ref="model_codestra_extension_assignment"/>
    <field name="groups" eval="[(4, ref('group_provisioning_user'))]"/>
    <field name="domain_force">[('pool_id.business_unit_id', 'in', user.call_center_business_unit_ids.ids)]</field>
  </record>
  <record id="rule_reservation_scope" model="ir.rule">
    <field name="name">Identifier reservation request scope</field>
    <field name="model_id" ref="model_codestra_identifier_reservation"/>
    <field name="groups" eval="[(4, ref('group_provisioning_user'))]"/>
    <field name="domain_force">[('request_id.business_unit_id', 'in', user.call_center_business_unit_ids.ids)]</field>
  </record>
  <record id="rule_audit_scope" model="ir.rule">
    <field name="name">Provisioning audit request scope</field>
    <field name="model_id" ref="model_codestra_provisioning_audit"/>
    <field name="groups" eval="[(4, ref('group_provisioning_user'))]"/>
    <field name="domain_force">[('request_id.business_unit_id', 'in', user.call_center_business_unit_ids.ids)]</field>
  </record>
</odoo>
