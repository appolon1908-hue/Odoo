<odoo>
  <!-- Three genuinely new, flat global/tenant roles. Deliberately NOT
       chained by implied_ids among themselves - platform_operator does
       not imply tenant_admin, tenant_admin does not imply platform_admin.
       Campaign-scoped supervisor/agent roles already exist
       (codestra_cc_security.group_cc_campaign_supervisor /
       group_cc_campaign_agent, enforced by
       codestra_cc_security's rule_cc_membership_global_scope via
       user.cc_supervised_campaign_ids / user.cc_allowed_campaign_ids) -
       reused here rather than duplicated. -->
  <record id="group_platform_operator" model="res.groups">
    <field name="name">Platform Operator</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    <field name="privilege_id" ref="privilege_identity_provisioning"/>
    <field name="sequence">60</field>
  </record>
  <record id="group_platform_admin" model="res.groups">
    <field name="name">Platform Admin</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    <field name="privilege_id" ref="privilege_identity_provisioning"/>
    <field name="sequence">70</field>
  </record>
  <record id="group_tenant_admin" model="res.groups">
    <field name="name">Tenant Admin</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    <field name="privilege_id" ref="privilege_identity_provisioning"/>
    <field name="sequence">45</field>
  </record>

  <!-- Backward compatibility only: an existing provisioning Super Admin
       automatically gets the new Platform Admin capability without
       needing re-assignment. This is the one and only implied_ids edge
       involving the three new groups - group_platform_admin itself
       implies nothing further, and group_platform_operator/
       group_tenant_admin are not implied by anything. -->
  <record id="group_provisioning_global_super_admin" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('group_platform_admin'))]"/>
  </record>

  <record id="rule_tenant_membership_scope" model="ir.rule">
    <field name="name">Tenant membership: platform admin or own tenant's admin</field>
    <field name="model_id" ref="model_codestra_tenant_membership"/>
    <field name="global" eval="True"/>
    <field name="domain_force">[(1, '=', 1)] if user.has_group('codestra_identity_provisioning.group_platform_admin') or user.has_group('codestra_identity_provisioning.group_provisioning_global_super_admin') else [('tenant_id', 'in', user.codestra_tenant_admin_ids.ids)]</field>
  </record>
  <record id="rule_platform_user_tenant_scope" model="ir.rule">
    <field name="name">Platform user: platform admin/operator, or own tenant's admin</field>
    <field name="model_id" ref="model_codestra_platform_user"/>
    <field name="global" eval="True"/>
    <field name="domain_force">[(1, '=', 1)] if user.has_group('codestra_identity_provisioning.group_platform_admin') or user.has_group('codestra_identity_provisioning.group_platform_operator') or user.has_group('codestra_identity_provisioning.group_provisioning_global_super_admin') else [('tenant_id', 'in', user.codestra_tenant_admin_ids.ids)]</field>
  </record>
</odoo>
