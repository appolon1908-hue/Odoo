<odoo>
  <record id="email_outbox_list" model="ir.ui.view">
    <field name="name">codestra.email.outbox.list</field>
    <field name="model">codestra.email.outbox</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0">
        <field name="mail_id"/><field name="company_id"/><field name="delivery_state"/>
        <field name="message_id"/><field name="provider_reference"/>
        <field name="attempts"/><field name="last_error_code"/><field name="next_attempt_at"/>
      </list>
    </field>
  </record>
  <record id="email_outbox_form" model="ir.ui.view">
    <field name="name">codestra.email.outbox.form</field>
    <field name="model">codestra.email.outbox</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <sheet><group>
          <field name="mail_id"/><field name="mail_message_id"/><field name="company_id"/>
          <field name="tenant_id"/><field name="correlation_id"/><field name="idempotency_key"/>
          <field name="state"/><field name="delivery_state"/><field name="message_id"/>
          <field name="provider_reference"/><field name="attempts"/>
          <field name="last_error_code"/><field name="next_attempt_at"/>
        </group></sheet>
      </form>
    </field>
  </record>
  <record id="email_outbox_action" model="ir.actions.act_window">
    <field name="name">Transactional Email Delivery</field>
    <field name="res_model">codestra.email.outbox</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="email_outbox_menu" name="Transactional Email Delivery"
            parent="base.menu_administration" action="email_outbox_action"
            groups="base.group_system"/>
</odoo>

