<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_codestra_rate_plan_list" model="ir.ui.view">
    <field name="name">codestra.rate.plan.list</field>
    <field name="model">codestra.rate.plan</field>
    <field name="arch" type="xml">
      <list string="Rate Plans">
        <field name="name"/>
        <field name="contract_id"/>
        <field name="campaign_id"/>
        <field name="billable_unit"/>
        <field name="client_unit_rate"/>
        <field name="provider_unit_cost"/>
        <field name="effective_from"/>
        <field name="effective_to"/>
        <field name="state"/>
      </list>
    </field>
  </record>
  <record id="view_codestra_rate_plan_form" model="ir.ui.view">
    <field name="name">codestra.rate.plan.form</field>
    <field name="model">codestra.rate.plan</field>
    <field name="arch" type="xml">
      <form string="Rate Plan">
        <header>
          <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'approved'"/>
          <button name="action_retire" type="object" string="Retire" invisible="state not in ('approved', 'active')"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,approved,active,retired"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <field name="contract_id"/>
            <field name="campaign_id"/>
            <field name="billable_unit"/>
            <field name="currency_id"/>
            <field name="client_unit_rate"/>
            <field name="provider_unit_cost"/>
            <field name="effective_from"/>
            <field name="effective_to"/>
            <field name="company_id" groups="base.group_multi_company"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_codestra_billing_usage_list" model="ir.ui.view">
    <field name="name">codestra.billing.usage.list</field>
    <field name="model">codestra.billing.usage</field>
    <field name="arch" type="xml">
      <list string="Billable Usage" default_order="occurred_at desc">
        <field name="name"/>
        <field name="contract_id"/>
        <field name="rate_plan_id"/>
        <field name="source_system"/>
        <field name="source_reference"/>
        <field name="occurred_at"/>
        <field name="units"/>
        <field name="revenue"/>
        <field name="provider_cost"/>
        <field name="margin"/>
        <field name="state"/>
      </list>
    </field>
  </record>
  <record id="view_codestra_billing_usage_form" model="ir.ui.view">
    <field name="name">codestra.billing.usage.form</field>
    <field name="model">codestra.billing.usage</field>
    <field name="arch" type="xml">
      <form string="Billable Usage">
        <header>
          <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending'"/>
          <button name="action_mark_invoiced" type="object" string="Mark Invoiced" class="btn-primary" invisible="state != 'approved'"/>
          <button name="action_reverse" type="object" string="Reverse" invisible="state not in ('pending', 'approved')"/>
          <field name="state" widget="statusbar" statusbar_visible="pending,approved,invoiced,reversed"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="contract_id"/>
              <field name="rate_plan_id"/>
              <field name="source_system"/>
              <field name="source_reference"/>
              <field name="idempotency_key"/>
              <field name="occurred_at"/>
            </group>
            <group>
              <field name="units"/>
              <field name="rate_snapshot" readonly="1"/>
              <field name="provider_cost_snapshot" readonly="1"/>
              <field name="revenue" readonly="1"/>
              <field name="provider_cost" readonly="1"/>
              <field name="margin" readonly="1"/>
              <field name="invoice_id"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_codestra_rate_plans" model="ir.actions.act_window">
    <field name="name">Rate Plans</field>
    <field name="res_model">codestra.rate.plan</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_codestra_billing_usage" model="ir.actions.act_window">
    <field name="name">Billable Usage</field>
    <field name="res_model">codestra.billing.usage</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_codestra_revenue_root" name="Revenue Assurance" parent="call_center_core.menu_call_center_root" sequence="80" groups="call_center_core.group_call_center_finance"/>
  <menuitem id="menu_codestra_rate_plans" name="Rate Plans" parent="menu_codestra_revenue_root" action="action_codestra_rate_plans" sequence="10"/>
  <menuitem id="menu_codestra_billing_usage" name="Billable Usage" parent="menu_codestra_revenue_root" action="action_codestra_billing_usage" sequence="20"/>
</odoo>
