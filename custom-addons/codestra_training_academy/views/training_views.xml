<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_codestra_training_course_list" model="ir.ui.view">
    <field name="name">codestra.training.course.list</field>
    <field name="model">codestra.training.course</field>
    <field name="arch" type="xml">
      <list string="Training Courses">
        <field name="code"/>
        <field name="name"/>
        <field name="version"/>
        <field name="passing_score"/>
        <field name="validity_days"/>
        <field name="active"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>

  <record id="view_codestra_training_course_form" model="ir.ui.view">
    <field name="name">codestra.training.course.form</field>
    <field name="model">codestra.training.course</field>
    <field name="arch" type="xml">
      <form string="Training Course">
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <field name="code"/>
            <field name="version"/>
            <field name="passing_score"/>
            <field name="validity_days"/>
            <field name="active"/>
            <field name="company_id" groups="base.group_multi_company"/>
          </group>
          <field name="description"/>
          <field name="enrollment_ids" readonly="1"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_codestra_training_enrollment_list" model="ir.ui.view">
    <field name="name">codestra.training.enrollment.list</field>
    <field name="model">codestra.training.enrollment</field>
    <field name="arch" type="xml">
      <list string="Training Enrollments">
        <field name="course_id"/>
        <field name="employee_id"/>
        <field name="state"/>
        <field name="score"/>
        <field name="attempts"/>
        <field name="completed_at"/>
        <field name="expires_at"/>
      </list>
    </field>
  </record>

  <record id="view_codestra_training_enrollment_form" model="ir.ui.view">
    <field name="name">codestra.training.enrollment.form</field>
    <field name="model">codestra.training.enrollment</field>
    <field name="arch" type="xml">
      <form string="Training Enrollment">
        <header>
          <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'assigned'"/>
          <button name="action_evaluate" type="object" string="Evaluate" class="btn-primary" invisible="state not in ('assigned', 'in_progress', 'failed')"/>
          <button name="action_expire" type="object" string="Expire" invisible="state != 'passed'"/>
          <button name="action_cancel" type="object" string="Cancel" invisible="state in ('passed', 'cancelled')"/>
          <field name="state" widget="statusbar" statusbar_visible="assigned,in_progress,passed,failed,expired,cancelled"/>
        </header>
        <sheet>
          <group>
            <field name="course_id"/>
            <field name="employee_id"/>
            <field name="score"/>
            <field name="attempts" readonly="1"/>
            <field name="agent_acknowledged"/>
            <field name="assigned_at" readonly="1"/>
            <field name="completed_at" readonly="1"/>
            <field name="expires_at" readonly="1"/>
            <field name="evaluator_id" readonly="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_codestra_training_courses" model="ir.actions.act_window">
    <field name="name">Training Courses</field>
    <field name="res_model">codestra.training.course</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_codestra_training_enrollments" model="ir.actions.act_window">
    <field name="name">Training Enrollments</field>
    <field name="res_model">codestra.training.enrollment</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_codestra_training_root" name="Training" parent="call_center_core.menu_call_center_root" sequence="77" groups="call_center_core.group_call_center_user"/>
  <menuitem id="menu_codestra_training_courses" name="Courses" parent="menu_codestra_training_root" action="action_codestra_training_courses" sequence="10" groups="call_center_core.group_call_center_user"/>
  <menuitem id="menu_codestra_training_enrollments" name="Enrollments" parent="menu_codestra_training_root" action="action_codestra_training_enrollments" sequence="20" groups="call_center_core.group_call_center_user"/>
</odoo>
