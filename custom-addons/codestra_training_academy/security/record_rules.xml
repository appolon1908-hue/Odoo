<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_codestra_training_course_company" model="ir.rule">
    <field name="name">Training courses by allowed company</field>
    <field name="model_id" ref="model_codestra_training_course"/>
    <field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_codestra_training_enrollment_company" model="ir.rule">
    <field name="name">Training enrollments by allowed company</field>
    <field name="model_id" ref="model_codestra_training_enrollment"/>
    <field name="groups" eval="[(4, ref('call_center_core.group_call_center_user'))]"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
