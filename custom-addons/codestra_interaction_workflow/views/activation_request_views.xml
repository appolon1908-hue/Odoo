<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_integration_retry_request_list" model="ir.ui.view">
    <field name="name">codestra.integration.retry.request.list</field>
    <field name="model">codestra.integration.retry.request</field>
    <field name="arch" type="xml"><list><field name="delivery_id"/><field name="correlation_id"/><field name="state"/><field name="requested_by"/><field name="create_date"/></list></field>
  </record>
  <record id="action_integration_retry_requests" model="ir.actions.act_window">
    <field name="name">Retry Requests</field><field name="res_model">codestra.integration.retry.request</field><field name="view_mode">list,form</field>
  </record>
  <record id="view_integration_activation_request_list" model="ir.ui.view">
    <field name="name">codestra.integration.activation.request.list</field>
    <field name="model">codestra.integration.activation.request</field>
    <field name="arch" type="xml"><list><field name="workflow_key"/><field name="workflow_version"/><field name="environment"/><field name="state"/><field name="requested_by"/><field name="create_date"/></list></field>
  </record>
  <record id="action_integration_activation_requests" model="ir.actions.act_window">
    <field name="name">Activation Requests</field><field name="res_model">codestra.integration.activation.request</field><field name="view_mode">list,form</field>
  </record>
</odoo>
