    <field name="name">Agents see only their schedules</field>
    <field name="model_id" ref="model_cc_workforce_schedule"/>
    <field name="groups" eval="[(4, ref('codestra_cc_security.group_cc_campaign_agent'))]"/>
    <field name="domain_force">[('agent_membership_id.user_id', '=', user.id)]</field>
  </record>
