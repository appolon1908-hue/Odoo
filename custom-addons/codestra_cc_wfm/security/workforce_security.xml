<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="codestra_cc_security.rule_cc_business_unit_global_scope" model="ir.rule">
    <field name="domain_force">[(1, '=', 1)] if user.has_group('codestra_cc_security.group_cc_global_administrator') or user.has_group('codestra_cc_wfm.group_cc_workforce_event_service') or user.cc_has_active_break_glass else [('id', 'in', user.cc_allowed_business_unit_ids.ids)]</field>
  </record>
  <record id="codestra_cc_security.rule_cc_campaign_global_scope" model="ir.rule">
    <field name="domain_force">[(1, '=', 1)] if user.has_group('codestra_cc_security.group_cc_global_administrator') or user.has_group('codestra_cc_wfm.group_cc_workforce_event_service') or user.cc_has_active_break_glass else [('id', 'in', user.cc_allowed_campaign_ids.ids)]</field>
  </record>
  <record id="codestra_cc_security.rule_cc_membership_global_scope" model="ir.rule">
    <field name="domain_force">[(1, '=', 1)] if user.has_group('codestra_cc_security.group_cc_global_administrator') or user.has_group('codestra_cc_calls.group_cc_call_service') or user.has_group('codestra_cc_recordings.group_cc_recording_service') or user.has_group('codestra_cc_wfm.group_cc_workforce_event_service') or user.cc_has_active_break_glass else ([('campaign_id', 'in', user.cc_allowed_campaign_ids.ids), ('role', '=', 'qa')] if user.has_group('codestra_cc_security.group_cc_quality_analyst') else ([('campaign_id', 'in', user.cc_allowed_campaign_ids.ids), ('role', 'in', ['agent', 'senior_agent', 'supervisor', 'workforce'])] if user.has_group('codestra_cc_security.group_cc_workforce_analyst') else ['&amp;', ('campaign_id', 'in', user.cc_allowed_campaign_ids.ids), '|', ('user_id', '=', user.id), ('campaign_id', 'in', user.cc_supervised_campaign_ids.ids)]))</field>
  </record>

  <record id="rule_wfm_policy_scoped" model="ir.rule">
    <field name="name">Workforce policy assigned campaigns</field>
    <field name="model_id" ref="model_cc_workforce_policy"/>
    <field name="groups" eval="[(4, ref('codestra_cc_security.group_cc_campaign_configuration_manager')), (4, ref('codestra_cc_security.group_cc_workforce_analyst')), (4, ref('codestra_cc_security.group_cc_campaign_supervisor'))]"/>
    <field name="domain_force">[('campaign_id', 'in', user.cc_allowed_campaign_ids.ids)]</field>
  </record>
  <record id="rule_wfm_policy_evidence" model="ir.rule">
    <field name="name">Workforce policy global evidence</field>
    <field name="model_id" ref="model_cc_workforce_policy"/>
    <field name="groups" eval="[(4, ref('codestra_cc_security.group_cc_global_administrator')), (4, ref('codestra_cc_security.group_cc_auditor'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
  </record>

  <record id="rule_wfm_forecast_scoped" model="ir.rule">
    <field name="name">Workforce forecasts assigned campaigns</field>
    <field name="model_id" ref="model_cc_workforce_forecast"/>
    <field name="groups" eval="[(4, ref('codestra_cc_security.group_cc_workforce_analyst')), (4, ref('codestra_cc_security.group_cc_campaign_supervisor'))]"/>
