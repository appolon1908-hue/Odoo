<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_cc_compliance_policy_list" model="ir.ui.view">
    <field name="name">cc.compliance.policy.list</field>
    <field name="model">cc.compliance.policy</field>
    <field name="arch" type="xml">
      <list delete="false">
        <field name="campaign_id"/>
        <field name="name"/>
        <field name="version"/>
        <field name="jurisdiction_code"/>
        <field name="channel"/>
        <field name="state"/>
        <field name="policy_hash" optional="hide"/>
      </list>
    </field>
  </record>
  <record id="view_cc_compliance_policy_form" model="ir.ui.view">
    <field name="name">cc.compliance.policy.form</field>
    <field name="model">cc.compliance.policy</field>
    <field name="arch" type="xml">
      <form delete="false">
        <header>
          <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'" groups="codestra_cc_security.group_cc_compliance_officer,codestra_cc_security.group_cc_global_administrator"/>
          <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'approved'" groups="codestra_cc_security.group_cc_compliance_officer,codestra_cc_security.group_cc_global_administrator"/>
          <button name="action_retire" type="object" string="Retire" invisible="state not in ['approved', 'active']" groups="codestra_cc_security.group_cc_compliance_officer,codestra_cc_security.group_cc_global_administrator"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,active,retired"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="campaign_id" readonly="state != 'draft'"/>
              <field name="name" readonly="state != 'draft'"/>
              <field name="version"/>
              <field name="jurisdiction_code" readonly="state != 'draft'"/>
              <field name="channel" readonly="state != 'draft'"/>
              <field name="source_reference"/>
            </group>
            <group>
              <field name="author_id"/>
              <field name="approver_id"/>
              <field name="approved_at"/>
              <field name="activated_at"/>
              <field name="policy_hash"/>
            </group>
          </group>
          <notebook>
            <page string="Consent and Calling Window">
              <group>
                <field name="consent_required" readonly="state != 'draft'"/>
                <field name="consent_text_version" readonly="state != 'draft'"/>
                <field name="allowed_weekdays" readonly="state != 'draft'"/>
                <field name="calling_hour_start" widget="float_time" readonly="state != 'draft'"/>
                <field name="calling_hour_end" widget="float_time" readonly="state != 'draft'"/>
                <field name="customer_timezone_required" readonly="state != 'draft'"/>
                <field name="suppression_latency_seconds" readonly="state != 'draft'"/>
              </group>
            </page>
            <page string="Closed Capabilities">
              <group>
                <field name="automated_outreach_allowed"/>
                <field name="predictive_dialing_allowed"/>
                <field name="ai_voice_allowed"/>
                <field name="prerecorded_voice_allowed"/>
                <field name="agent_bulk_export_allowed"/>
                <field name="supervisor_bulk_export_allowed"/>
              </group>
            </page>
            <page string="Payment Safety">
              <group>
                <field name="secure_payment_link_required" readonly="state != 'draft'"/>
                <field name="payment_tokenization_required" readonly="state != 'draft'"/>
                <field name="payment_recording_pause_required" readonly="state != 'draft'"/>
                <field name="direct_payment_capture_allowed"/>
              </group>
            </page>
            <page string="Retention">
              <group>
                <field name="crm_retention_days" readonly="state != 'draft'"/>
                <field name="mail_retention_days" readonly="state != 'draft'"/>
                <field name="recording_retention_days" readonly="state != 'draft'"/>
                <field name="consent_retention_days" readonly="state != 'draft'"/>
                <field name="audit_retention_days" readonly="state != 'draft'"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_cc_compliance_policy" model="ir.actions.act_window">
    <field name="name">Compliance Policies</field>
    <field name="res_model">cc.compliance.policy</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_cc_consent_evidence_list" model="ir.ui.view">
    <field name="name">cc.consent.evidence.list</field>
    <field name="model">cc.consent.evidence</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="occurred_at"/>
        <field name="campaign_id"/>
        <field name="customer_profile_id"/>
        <field name="channel"/>
        <field name="status"/>
        <field name="consent_source"/>
        <field name="consent_text_version"/>
        <field name="actor_id"/>
        <field name="evidence_hash" optional="hide"/>
      </list>
    </field>
  </record>
  <record id="action_cc_consent_evidence" model="ir.actions.act_window">
    <field name="name">Consent and Revocation Evidence</field>
    <field name="res_model">cc.consent.evidence</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
  </record>

  <record id="view_cc_suppression_entry_list" model="ir.ui.view">
    <field name="name">cc.suppression.entry.list</field>
    <field name="model">cc.suppression.entry</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="recorded_at"/>
        <field name="campaign_id"/>
        <field name="customer_profile_id"/>
        <field name="identifier_type"/>
        <field name="reason"/>
        <field name="state"/>
        <field name="recorded_by_id"/>
        <field name="evidence_hash" optional="hide"/>
      </list>
    </field>
  </record>
  <record id="action_cc_suppression_entry" model="ir.actions.act_window">
    <field name="name">DNC and Suppression</field>
    <field name="res_model">cc.suppression.entry</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
  </record>

  <record id="view_cc_contact_eligibility_list" model="ir.ui.view">
    <field name="name">cc.contact.eligibility.evidence.list</field>
    <field name="model">cc.contact.eligibility.evidence</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="evaluated_at"/>
        <field name="campaign_id"/>
        <field name="customer_profile_id"/>
        <field name="channel"/>
        <field name="dial_mode"/>
        <field name="voice_mode"/>
        <field name="customer_timezone"/>
        <field name="result"/>
        <field name="reason_codes" optional="show"/>
      </list>
    </field>
  </record>
  <record id="action_cc_contact_eligibility" model="ir.actions.act_window">
    <field name="name">Pre-Dial Compliance Decisions</field>
    <field name="res_model">cc.contact.eligibility.evidence</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
  </record>

  <record id="view_cc_payment_safety_session_list" model="ir.ui.view">
    <field name="name">cc.payment.safety.session.list</field>
    <field name="model">cc.payment.safety.session</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="requested_at"/>
        <field name="campaign_id"/>
        <field name="customer_profile_id"/>
        <field name="agent_membership_id"/>
        <field name="call_unique_id"/>
        <field name="state"/>
        <field name="recording_id" optional="show"/>
        <field name="final_evidence_hash" optional="hide"/>
      </list>
    </field>
  </record>
  <record id="action_cc_payment_safety_session" model="ir.actions.act_window">
    <field name="name">Payment Safety Evidence</field>
    <field name="res_model">cc.payment.safety.session</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
  </record>

  <record id="view_cc_legal_hold_list" model="ir.ui.view">
    <field name="name">cc.legal.hold.list</field>
    <field name="model">cc.legal.hold</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="requested_at"/>
        <field name="campaign_id"/>
        <field name="target_model"/>
        <field name="state"/>
        <field name="requested_by_id"/>
        <field name="approved_by_id"/>
        <field name="released_by_id" optional="show"/>
        <field name="evidence_hash" optional="hide"/>
      </list>
    </field>
  </record>
  <record id="action_cc_legal_hold" model="ir.actions.act_window">
    <field name="name">Legal Holds</field>
    <field name="res_model">cc.legal.hold</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
