  <record id="view_cc_retention_decision_list" model="ir.ui.view">
    <field name="name">cc.retention.decision.list</field>
    <field name="model">cc.retention.decision</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="evaluated_at"/>
