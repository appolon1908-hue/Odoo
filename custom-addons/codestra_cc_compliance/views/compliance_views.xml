        <field name="target_model"/>
        <field name="record_created_at"/>
        <field name="retain_until"/>
        <field name="legal_hold_id"/>
        <field name="outcome"/>
        <field name="evidence_hash" optional="hide"/>
      </list>
    </field>
  </record>
  <record id="action_cc_retention_decision" model="ir.actions.act_window">
    <field name="name">Retention Decisions</field>
    <field name="res_model">cc.retention.decision</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
  </record>

  <menuitem id="menu_cc_compliance_governance" name="Compliance Governance"
            parent="call_center_core.menu_call_center_root" sequence="80"
            groups="codestra_cc_security.group_cc_campaign_configuration_manager,codestra_cc_security.group_cc_compliance_officer,codestra_cc_security.group_cc_auditor,codestra_cc_security.group_cc_global_administrator"/>
  <menuitem id="menu_cc_compliance_policy" name="Policies"
            parent="menu_cc_compliance_governance" action="action_cc_compliance_policy" sequence="10"/>
  <menuitem id="menu_cc_consent_evidence" name="Consent and Revocation"
            parent="menu_cc_compliance_governance" action="action_cc_consent_evidence" sequence="20"/>
  <menuitem id="menu_cc_suppression_entry" name="DNC and Suppression"
            parent="menu_cc_compliance_governance" action="action_cc_suppression_entry" sequence="30"/>
  <menuitem id="menu_cc_contact_eligibility" name="Pre-Dial Decisions"
            parent="menu_cc_compliance_governance" action="action_cc_contact_eligibility" sequence="40"/>
  <menuitem id="menu_cc_payment_safety" name="Payment Safety"
            parent="menu_cc_compliance_governance" action="action_cc_payment_safety_session" sequence="50"/>
  <menuitem id="menu_cc_legal_hold" name="Legal Holds"
