<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="codestra_cc_security.rule_cc_membership_global_scope" model="ir.rule">
    <field name="domain_force">[(1, '=', 1)] if user.has_group('codestra_cc_security.group_cc_global_administrator') or user.has_group('codestra_cc_calls.group_cc_call_service') or user.has_group('codestra_cc_recordings.group_cc_recording_service') or user.cc_has_active_break_glass else ([('campaign_id', 'in', user.cc_allowed_campaign_ids.ids), ('role', '=', 'qa')] if user.has_group('codestra_cc_security.group_cc_quality_analyst') else ['&amp;', ('campaign_id', 'in', user.cc_allowed_campaign_ids.ids), '|', ('user_id', '=', user.id), ('campaign_id', 'in', user.cc_supervised_campaign_ids.ids)])</field>
  </record>
