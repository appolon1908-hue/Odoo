<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_codestra_scrapper" model="ir.module.category">
        <field name="name">Codestra Scrapper Integration</field>
        <field name="description">Governed Scrapper-to-Odoo projection roles.</field>
        <field name="sequence">65</field>
    </record>

    <record id="group_scrapper_projection_auditor" model="res.groups">
        <field name="name">Projection Auditor</field>
        <field name="category_id" ref="module_category_codestra_scrapper"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_scrapper_projection_service" model="res.groups">
        <field name="name">Projection Service</field>
        <field name="category_id" ref="module_category_codestra_scrapper"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Non-interactive group; exact tenant-to-user binding is also required.</field>
    </record>

    <record id="group_scrapper_projection_manager" model="res.groups">
        <field name="name">Projection Manager</field>
        <field name="category_id" ref="module_category_codestra_scrapper"/>
        <field name="implied_ids" eval="[(4, ref('group_scrapper_projection_auditor'))]"/>
    </record>
</odoo>
