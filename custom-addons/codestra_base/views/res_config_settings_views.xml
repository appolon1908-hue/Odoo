<odoo>
  <record id="res_config_settings_view_form_codestra_base" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.codestra.base</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app string="Codestra Base" name="codestra_base">
          <block title="Safe configuration">
            <p>All Codestra integration flags are fail-closed and default to disabled.</p>
            <group><field name="live_writes_enabled"/><field name="odoo_sync_enabled"/><field name="n8n_delivery_enabled"/><field name="vicidial_read_enabled"/><field name="vicidial_write_enabled"/><field name="agent_api_read_enabled"/><field name="agent_api_write_enabled"/><field name="call_control_enabled"/><field name="transfer_control_enabled"/><field name="recording_access_enabled"/><field name="ai_advisory_enabled"/><field name="ai_external_delivery_enabled"/></group>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
