<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_codestra_agent_onboarding_list" model="ir.ui.view">
    <field name="name">codestra.agent.onboarding.list</field>
    <field name="model">codestra.agent.onboarding</field>
    <field name="arch" type="xml">
      <list string="Agent Onboarding" default_order="target_start_date desc">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="campaign_id"/>
        <field name="campaign_role"/>
        <field name="supervisor_id"/>
        <field name="target_start_date"/>
        <field name="completion_percent"/>
        <field name="provisioning_request_id"/>
        <field name="state"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>

  <record id="view_codestra_agent_onboarding_form" model="ir.ui.view">
    <field name="name">codestra.agent.onboarding.form</field>
    <field name="model">codestra.agent.onboarding</field>
    <field name="arch" type="xml">
      <form string="Agent Onboarding">
        <header>
          <button name="action_submit" type="object" string="Submit for Review"
                  class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_approve" type="object" string="Approve Readiness"
                  class="btn-primary" invisible="state != 'in_review'"/>
          <button name="action_prepare_access" type="object"
                  string="Prepare Access Request" class="btn-primary"
                  groups="codestra_cc_security.group_cc_global_administrator"
                  invisible="state != 'approved' or provisioning_request_id"/>
          <button name="action_start_provisioning" type="object"
                  string="Start Disabled Provisioning" class="btn-primary"
                  groups="codestra_cc_security.group_cc_global_administrator"
                  invisible="state != 'approved' or not provisioning_request_id"/>
          <button name="action_request_activation_email" type="object"
                  string="Request Secure Login Email" class="btn-primary"
                  groups="codestra_cc_security.group_cc_global_administrator"
                  invisible="state != 'provisioning' or activation_outbox_id"/>
          <button name="action_activate" type="object" string="Activate Agent"
                  class="btn-primary" invisible="state != 'provisioning'"/>
          <button name="action_begin_offboarding" type="object"
                  string="Begin Offboarding" invisible="state != 'active'"/>
          <button name="action_close" type="object" string="Close"
                  invisible="state not in ('offboarding', 'cancelled')"/>
          <button name="action_fail" type="object" string="Mark Failed"
                  invisible="state in ('closed', 'cancelled')"/>
          <button name="action_cancel" type="object" string="Cancel"
                  invisible="state not in ('draft', 'in_review', 'approved')"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,in_review,approved,provisioning,active,offboarding,closed"/>
        </header>

        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>

          <group>
            <group string="Person">
              <field name="employee_id" readonly="campaign_membership_id"/>
              <field name="manager_id"/>
              <field name="target_start_date"/>
              <field name="activation_email"
                     readonly="campaign_membership_id"
                     placeholder="agent@example.com"/>
              <field name="preferred_language"/>
              <field name="timezone"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
            <group string="Control">
              <field name="integration_uuid" readonly="1"/>
              <field name="desired_state_version" readonly="1"/>
              <field name="completion_percent" readonly="1"/>
              <field name="access_request_prepared_at" readonly="1"/>
              <field name="provisioning_started_at" readonly="1"/>
              <field name="activation_email_requested_at" readonly="1"/>
              <field name="failure_reason" invisible="state != 'failed'"/>
            </group>
          </group>

          <notebook>
            <page string="Campaign Assignment">
              <group>
                <group>
                  <field name="campaign_id"
                         domain="[('is_human_staffed', '=', True), ('identifier_status', '=', 'canonical')]"
                         readonly="campaign_membership_id"/>
                  <field name="business_unit_id" readonly="1"/>
                  <field name="campaign_role" readonly="campaign_membership_id"/>
                  <field name="branch_id"
                         domain="[('business_unit_ids', 'in', business_unit_id)]"
                         readonly="campaign_membership_id"/>
                </group>
                <group>
                  <field name="department_id"
                         domain="[('business_unit_id', '=', business_unit_id)]"
                         readonly="campaign_membership_id"/>
                  <field name="operational_team_id"
                         domain="[('business_unit_id', '=', business_unit_id), ('department_id', '=', department_id)]"
                         readonly="campaign_membership_id"/>
                  <field name="supervisor_id"
                         domain="[('id', 'in', operational_team_id.supervisor_ids)]"
                         readonly="campaign_membership_id"/>
                  <field name="role_template_id"
                         domain="[('business_unit_id', '=', business_unit_id), ('active', '=', True)]"
                         readonly="campaign_membership_id"/>
                </group>
              </group>
              <div class="alert alert-info" role="status">
                An agent can hold only one active operational campaign membership.
                Campaign changes use the governed revoke-then-grant workflow; the
                campaign field cannot be switched in place after access is prepared.
              </div>
            </page>

            <page string="Readiness Gates">
              <group>
                <field name="identity_verified"/>
                <field name="employment_documents_complete"/>
                <field name="approved_checks_complete"/>
                <field name="equipment_ready"/>
                <field name="training_complete"/>
                <field name="compliance_approved"/>
              </group>
            </page>

            <page string="Provisioning">
              <group>
                <group string="Requested Accounts">
                  <field name="needs_keycloak"/>
                  <field name="needs_vicidial"/>
                  <field name="needs_sip_endpoint" string="Phone"/>
                  <field name="needs_agent_desktop"/>
                  <field name="webrtc_enabled"/>
                </group>
                <group string="Requested Services">
                  <field name="needs_company_email" string="Company Email"/>
                  <field name="sms_enabled"/>
                  <field name="incoming_calls_enabled"/>
                  <field name="outgoing_calls_enabled"/>
                  <field name="needs_voicemail"/>
                  <field name="needs_recording_access"/>
                  <field name="needs_monitoring_access"/>
                </group>
              </group>
              <group string="Durable Links">
                <field name="campaign_membership_id" readonly="1"/>
                <field name="provisioning_request_id" readonly="1"/>
                <field name="provisioning_outbox_id" readonly="1"/>
                <field name="activation_outbox_id" readonly="1"/>
              </group>
              <div class="alert alert-warning" role="status">
                External identities are created disabled and verified before any
                activation. The welcome email contains the approved login identifier
                and a Keycloak one-time action flow. Odoo never stores or emails a
                reusable plaintext password.
              </div>
            </page>

            <page string="Channels">
              <field name="channel_ids" readonly="1">
                <list create="0" edit="0" delete="0">
                  <field name="channel_type"/>
                  <field name="desired_enabled"/>
                  <field name="incoming_allowed"/>
                  <field name="outgoing_allowed"/>
                  <field name="extension"/>
                  <field name="state"/>
                  <field name="effective_access"/>
                </list>
              </field>
              <div class="alert alert-info" role="status">
                Channel switches are desired state. Email and SMS delivery, phone
                calls, and WebRTC credentials are performed only after governed
                Middleware read-back. One WebRTC endpoint is allowed per agent.
              </div>
            </page>

            <page string="Notes">
              <field name="notes"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_codestra_agent_onboarding" model="ir.actions.act_window">
    <field name="name">Agent Onboarding</field>
    <field name="res_model">codestra.agent.onboarding</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_codestra_agent_onboarding" name="Agent Onboarding"
            parent="call_center_core.menu_call_center_root"
            action="action_codestra_agent_onboarding" sequence="76"
            groups="call_center_core.group_call_center_manager"/>

  <record id="view_codestra_agent_channel_list" model="ir.ui.view">
    <field name="name">codestra.agent.channel.list</field>
    <field name="model">codestra.agent.channel</field>
    <field name="arch" type="xml">
      <list string="Agent Channels">
        <field name="employee_id"/>
        <field name="user_id"/>
        <field name="campaign_id"/>
        <field name="supervisor_id"/>
        <field name="channel_type"/>
        <field name="desired_enabled"/>
        <field name="incoming_allowed"/>
        <field name="outgoing_allowed"/>
        <field name="extension"/>
        <field name="state"/>
        <field name="effective_access"/>
      </list>
    </field>
  </record>

  <record id="view_codestra_agent_channel_form" model="ir.ui.view">
    <field name="name">codestra.agent.channel.form</field>
    <field name="model">codestra.agent.channel</field>
    <field name="arch" type="xml">
      <form string="Agent Channel">
        <header>
          <field name="state" widget="statusbar"
                 statusbar_visible="requested,provisioned,effective,disabled,failed"/>
        </header>
        <sheet>
          <group>
            <group string="Assignment">
              <field name="employee_id"/>
              <field name="user_id" readonly="1"/>
              <field name="campaign_id"/>
              <field name="supervisor_id"/>
              <field name="membership_id"/>
              <field name="provisioning_request_id" readonly="1"/>
            </group>
            <group string="Channel">
              <field name="channel_type"/>
              <field name="desired_enabled"/>
              <field name="incoming_allowed"
                     invisible="channel_type not in ('phone', 'webrtc')"/>
              <field name="outgoing_allowed"
                     invisible="channel_type not in ('phone', 'webrtc')"/>
              <field name="extension" readonly="1"/>
              <field name="effective_access" readonly="1"/>
              <field name="endpoint_reference" readonly="1"/>
              <field name="external_id" readonly="1"/>
              <field name="readback_evidence_hash" readonly="1"/>
            </group>
          </group>
          <div class="alert alert-warning" role="status">
            This record controls desired access only. It never stores a password,
            sends a message, creates a phone call, or issues a WebRTC credential.
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_codestra_agent_channels" model="ir.actions.act_window">
    <field name="name">Agent Channels</field>
    <field name="res_model">codestra.agent.channel</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_codestra_agent_channels" name="Agent Channels"
            parent="menu_codestra_agent_onboarding"
            action="action_codestra_agent_channels" sequence="10"
            groups="call_center_core.group_call_center_manager"/>

</odoo>
