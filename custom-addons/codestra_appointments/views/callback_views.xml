<odoo>
 <record id="callback_list" model="ir.ui.view"><field name="name">codestra.callback.list</field><field name="model">codestra.callback</field><field name="arch" type="xml"><list decoration-danger="state in ('missed','escalated')" decoration-warning="priority in ('high','urgent')"><field name="scheduled_at"/><field name="contact_id"/><field name="campaign_id"/><field name="assigned_agent_id"/><field name="assigned_team_id"/><field name="reason"/><field name="priority" widget="badge"/><field name="state" widget="badge"/><field name="version"/></list></field></record>
 <record id="callback_form" model="ir.ui.view"><field name="name">codestra.callback.form</field><field name="model">codestra.callback</field><field name="arch" type="xml"><form><header><button name="action_schedule" type="object" string="Schedule" invisible="state != 'draft'" class="btn-primary"/><button name="action_start" type="object" string="Start" invisible="state not in ('due','missed','escalated')" class="btn-primary"/><button name="action_complete" type="object" string="Complete" invisible="state != 'in_progress'" class="btn-primary"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed','cancelled')"/><button name="action_reconcile_middleware" type="object" string="Reconcile" invisible="not middleware_callback_uuid"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="callback_uuid" readonly="1"/><field name="middleware_callback_uuid" readonly="1"/><field name="middleware_version" readonly="1"/><field name="middleware_sync_state" readonly="1"/><field name="contact_id"/><field name="lead_id"/><field name="phone_number"/><field name="campaign_id"/><field name="business_unit_id"/></group><group><field name="scheduled_at"/><field name="customer_timezone"/><field name="priority"/><field name="assigned_agent_id"/><field name="assigned_team_id"/><field name="supervisor_id"/></group></group><group><field name="reason"/><field name="notes"/><field name="compliance_allowed" readonly="1"/><field name="version" readonly="1"/></group><notebook><page string="Completion"><field name="completion_disposition"/><field name="completion_notes"/></page><page string="History"><field name="history_ids" readonly="1"><list><field name="occurred_at"/><field name="event_type"/><field name="from_state"/><field name="to_state"/><field name="actor_id"/><field name="correlation_id"/></list></field></page></notebook></sheet><chatter/></form></field></record>
 <record id="callback_action" model="ir.actions.act_window"><field name="name">Callbacks</field><field name="res_model">codestra.callback</field><field name="view_mode">list,form</field></record>
 <menuitem id="callback_menu" name="Callbacks" action="callback_action" sequence="40" groups="codestra.group_agent"/>
</odoo>
