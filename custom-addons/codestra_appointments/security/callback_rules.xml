<odoo noupdate="1">
 <record id="appointment_agent_own_rule" model="ir.rule"><field name="name">Agents see assigned appointments</field><field name="model_id" ref="model_codestra_call_appointment"/><field name="groups" eval="[(4,ref('codestra.group_agent'))]"/><field name="domain_force">['&amp;',('business_unit_id','in',user.call_center_business_unit_ids.ids),'|',('agent_id','=',user.id),('team_id.agent_ids','in',user.id)]</field></record>
 <record id="appointment_supervisor_scope_rule" model="ir.rule"><field name="name">Supervisors see authorized appointments</field><field name="model_id" ref="model_codestra_call_appointment"/><field name="groups" eval="[(4,ref('codestra.group_supervisor'))]"/><field name="domain_force">[('business_unit_id','in',user.call_center_business_unit_ids.ids),('campaign_id','in',user.call_center_campaign_ids.ids)]</field></record>
 <record id="appointment_reminder_scope_rule" model="ir.rule"><field name="name">Appointment reminders follow appointment access</field><field name="model_id" ref="model_codestra_appointment_reminder_event"/><field name="groups" eval="[(4,ref('codestra.group_agent'))]"/><field name="domain_force">[('appointment_id.business_unit_id','in',user.call_center_business_unit_ids.ids),'|',('recipient_id','=',user.id),('appointment_id.team_id.agent_ids','in',user.id)]</field></record>
 <record id="appointment_reminder_supervisor_scope_rule" model="ir.rule"><field name="name">Supervisors see authorized appointment reminders</field><field name="model_id" ref="model_codestra_appointment_reminder_event"/><field name="groups" eval="[(4,ref('codestra.group_supervisor'))]"/><field name="domain_force">[('appointment_id.business_unit_id','in',user.call_center_business_unit_ids.ids),('appointment_id.campaign_id','in',user.call_center_campaign_ids.ids)]</field></record>
 <record id="callback_agent_own_rule" model="ir.rule"><field name="name">Agents see assigned callbacks</field><field name="model_id" ref="model_codestra_callback"/><field name="groups" eval="[(4,ref('codestra.group_agent'))]"/><field name="domain_force">['&amp;',('business_unit_id','in',user.call_center_business_unit_ids.ids),'|',('assigned_agent_id','=',user.id),('assigned_team_id.agent_ids','in',user.id)]</field></record>
 <record id="callback_supervisor_team_rule" model="ir.rule"><field name="name">Supervisors see authorized team callbacks</field><field name="model_id" ref="model_codestra_callback"/><field name="groups" eval="[(4,ref('codestra.group_supervisor'))]"/><field name="domain_force">[('business_unit_id','in',user.call_center_business_unit_ids.ids),('campaign_id','in',user.call_center_campaign_ids.ids)]</field></record>
 <record id="callback_history_scope_rule" model="ir.rule"><field name="name">Callback history follows callback access</field><field name="model_id" ref="model_codestra_callback_history"/><field name="groups" eval="[(4,ref('codestra.group_agent'))]"/><field name="domain_force">[('callback_id.business_unit_id','in',user.call_center_business_unit_ids.ids)]</field></record>
</odoo>
