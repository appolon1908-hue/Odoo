<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="mail_template_cod_web_out_initial_outreach_v1" model="mail.template">
    <field name="name">COD-WEB-OUT Initial Outreach v1</field><field name="model_id" ref="crm.model_crm_lead"/>
    <field name="subject">A practical conversation about {{ object.partner_name or object.name }}</field>
    <field name="body_html" type="html"><div><p>Hello <t t-out="object.contact_name or 'there'"/>,</p><p>We would welcome a brief conversation to understand your current web, application, or AI priorities and determine whether Codestra can help.</p><p>Regards,<br/>Codestra</p></div></field>
    <field name="codestra_plain_body">Hello, We would welcome a brief conversation to understand your current web, application, or AI priorities and determine whether Codestra can help. Regards, Codestra</field>
    <field name="codestra_template_key">cod_web_out_initial_outreach_v1</field><field name="codestra_template_version">1</field><field name="codestra_locale">en_US</field>
    <field name="codestra_sender_identity_ref">SALES_SENDER</field><field name="codestra_reply_to_identity_ref">SUPPORT_REPLY_TO</field><field name="codestra_safe_variables">["contact_name","partner_name","name"]</field>
  </record>
  <record id="mail_template_cod_web_out_followup_1_v1" model="mail.template"><field name="name">COD-WEB-OUT Follow-up 1 v1</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">Following up on your development priorities</field><field name="body_html" type="html"><div><p>Hello <t t-out="object.contact_name or 'there'"/>,</p><p>I am following up in case a short discovery conversation would be useful. There is no obligation.</p><p>Regards,<br/>Codestra</p></div></field><field name="codestra_plain_body">Hello, I am following up in case a short discovery conversation would be useful. There is no obligation. Regards, Codestra</field><field name="codestra_template_key">cod_web_out_followup_1_v1</field><field name="codestra_sender_identity_ref">SALES_SENDER</field><field name="codestra_reply_to_identity_ref">SUPPORT_REPLY_TO</field><field name="codestra_safe_variables">["contact_name"]</field></record>
  <record id="mail_template_cod_web_out_followup_2_v1" model="mail.template"><field name="name">COD-WEB-OUT Follow-up 2 v1</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">One last follow-up from Codestra</field><field name="body_html" type="html"><div><p>Hello <t t-out="object.contact_name or 'there'"/>,</p><p>This is one final follow-up. If the timing is not right, no action is needed.</p><p>Regards,<br/>Codestra</p></div></field><field name="codestra_plain_body">Hello, This is one final follow-up. If the timing is not right, no action is needed. Regards, Codestra</field><field name="codestra_template_key">cod_web_out_followup_2_v1</field><field name="codestra_sender_identity_ref">SALES_SENDER</field><field name="codestra_reply_to_identity_ref">SUPPORT_REPLY_TO</field><field name="codestra_safe_variables">["contact_name"]</field></record>
  <record id="mail_template_cod_web_out_discovery_invitation_v1" model="mail.template"><field name="name">COD-WEB-OUT Discovery Invitation v1</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">Discovery conversation</field><field name="body_html" type="html"><div><p>Hello <t t-out="object.contact_name or 'there'"/>,</p><p>Would you like to schedule a focused discovery conversation about your requirements?</p><p>Regards,<br/>Codestra</p></div></field><field name="codestra_plain_body">Hello, Would you like to schedule a focused discovery conversation about your requirements? Regards, Codestra</field><field name="codestra_template_key">cod_web_out_discovery_invitation_v1</field><field name="codestra_sender_identity_ref">SALES_SENDER</field><field name="codestra_reply_to_identity_ref">SUPPORT_REPLY_TO</field><field name="codestra_safe_variables">["contact_name"]</field></record>
  <record id="mail_template_cod_web_out_discovery_confirmation_v1" model="mail.template"><field name="name">COD-WEB-OUT Discovery Confirmation v1</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">Discovery session confirmed</field><field name="body_html" type="html"><div><p>Your Codestra discovery session is confirmed. Please use the appointment details already provided in the secure scheduling record.</p></div></field><field name="codestra_plain_body">Your Codestra discovery session is confirmed. Please use the appointment details already provided in the secure scheduling record.</field><field name="codestra_template_key">cod_web_out_discovery_confirmation_v1</field><field name="codestra_sender_identity_ref">SALES_SENDER</field><field name="codestra_reply_to_identity_ref">SUPPORT_REPLY_TO</field><field name="codestra_safe_variables">[]</field></record>
  <record id="mail_template_cod_web_out_discovery_reminder_v1" model="mail.template"><field name="name">COD-WEB-OUT Discovery Reminder v1</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">Reminder: Codestra discovery session</field><field name="body_html" type="html"><div><p>This is a reminder for your scheduled Codestra discovery session. Please refer to the secure appointment details.</p></div></field><field name="codestra_plain_body">This is a reminder for your scheduled Codestra discovery session. Please refer to the secure appointment details.</field><field name="codestra_template_key">cod_web_out_discovery_reminder_v1</field><field name="codestra_sender_identity_ref">SALES_SENDER</field><field name="codestra_reply_to_identity_ref">SUPPORT_REPLY_TO</field><field name="codestra_safe_variables">[]</field></record>
  <record id="mail_template_cod_web_out_post_discovery_followup_v1" model="mail.template"><field name="name">COD-WEB-OUT Post-discovery Follow-up v1</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">Next steps after our discovery session</field><field name="body_html" type="html"><div><p>Thank you for the discovery conversation. We will follow the agreed next steps recorded for your project.</p></div></field><field name="codestra_plain_body">Thank you for the discovery conversation. We will follow the agreed next steps recorded for your project.</field><field name="codestra_template_key">cod_web_out_post_discovery_followup_v1</field><field name="codestra_sender_identity_ref">SALES_SENDER</field><field name="codestra_reply_to_identity_ref">SUPPORT_REPLY_TO</field><field name="codestra_safe_variables">[]</field></record>
  <record id="mail_template_cod_web_out_proposal_sent_v1" model="mail.template"><field name="name">COD-WEB-OUT Proposal Sent v1</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">Your Codestra proposal</field><field name="body_html" type="html"><div><p>Your proposal is ready. Please use the approved secure document channel to review it.</p></div></field><field name="codestra_plain_body">Your proposal is ready. Please use the approved secure document channel to review it.</field><field name="codestra_template_key">cod_web_out_proposal_sent_v1</field><field name="codestra_sender_identity_ref">SALES_SENDER</field><field name="codestra_reply_to_identity_ref">SUPPORT_REPLY_TO</field><field name="codestra_safe_variables">[]</field></record>
  <record id="mail_template_cod_web_out_proposal_followup_v1" model="mail.template"><field name="name">COD-WEB-OUT Proposal Follow-up v1</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">Questions about your Codestra proposal</field><field name="body_html" type="html"><div><p>We are available to clarify any part of the proposal or discuss practical next steps.</p></div></field><field name="codestra_plain_body">We are available to clarify any part of the proposal or discuss practical next steps.</field><field name="codestra_template_key">cod_web_out_proposal_followup_v1</field><field name="codestra_sender_identity_ref">SALES_SENDER</field><field name="codestra_reply_to_identity_ref">SUPPORT_REPLY_TO</field><field name="codestra_safe_variables">[]</field></record>
  <record id="mail_template_cod_web_out_contract_followup_v1" model="mail.template"><field name="name">COD-WEB-OUT Contract Follow-up v1</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">Contract review follow-up</field><field name="body_html" type="html"><div><p>Please let us know if any contract point needs clarification. No action will be taken without your approval.</p></div></field><field name="codestra_plain_body">Please let us know if any contract point needs clarification. No action will be taken without your approval.</field><field name="codestra_template_key">cod_web_out_contract_followup_v1</field><field name="codestra_sender_identity_ref">SALES_SENDER</field><field name="codestra_reply_to_identity_ref">SUPPORT_REPLY_TO</field><field name="codestra_safe_variables">[]</field></record>
  <record id="mail_template_cod_web_out_project_handoff_v1" model="mail.template"><field name="name">COD-WEB-OUT Project Handoff v1</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">Your Codestra project handoff</field><field name="body_html" type="html"><div><p>Your project has moved to the approved delivery handoff. Your project contact will provide next steps through the established channel.</p></div></field><field name="codestra_plain_body">Your project has moved to the approved delivery handoff. Your project contact will provide next steps through the established channel.</field><field name="codestra_template_key">cod_web_out_project_handoff_v1</field><field name="codestra_sender_identity_ref">SALES_SENDER</field><field name="codestra_reply_to_identity_ref">SUPPORT_REPLY_TO</field><field name="codestra_safe_variables">[]</field></record>
  <record id="mail_template_cod_web_out_no_response_close_v1" model="mail.template"><field name="name">COD-WEB-OUT No-response Close v1</field><field name="model_id" ref="crm.model_crm_lead"/><field name="subject">Closing this conversation for now</field><field name="body_html" type="html"><div><p>We will close this conversation for now. You are welcome to contact Codestra if priorities change.</p></div></field><field name="codestra_plain_body">We will close this conversation for now. You are welcome to contact Codestra if priorities change.</field><field name="codestra_template_key">cod_web_out_no_response_close_v1</field><field name="codestra_sender_identity_ref">SALES_SENDER</field><field name="codestra_reply_to_identity_ref">SUPPORT_REPLY_TO</field><field name="codestra_safe_variables">[]</field></record>
