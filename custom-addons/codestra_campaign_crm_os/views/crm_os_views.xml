<odoo>
 <record id="view_crm_lead_corporate_desktop" model="ir.ui.view">
  <field name="name">crm.lead.corporate.agent.desktop</field><field name="model">crm.lead</field>
  <field name="inherit_id" ref="crm.crm_lead_view_form"/>
  <field name="arch" type="xml">
   <xpath expr="//notebook" position="inside">
    <page string="Campaign Operations">
     <group><group string="Assignment"><field name="business_unit_id"/><field name="call_center_campaign_id"/><field name="codestra_workflow_id"/><field name="assigned_agent_profile_id"/><field name="codestra_supervisor_id"/><field name="codestra_manager_id"/></group><group string="Current Work"><field name="codestra_current_status_id"/><field name="codestra_previous_status_id"/><field name="status_entered_at"/><field name="next_action_type"/><field name="next_action_owner_id"/><field name="next_action_at"/><field name="migration_review_required"/></group></group>
    </page>
    <page string="Client 360 Timeline"><field name="codestra_timeline_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="occurred_at"/><field name="event_type"/><field name="actor_type"/><field name="actor_id"/><field name="action"/><field name="visibility"/><field name="correlation_id"/></list></field></page>
    <page string="Communications"><field name="codestra_communication_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="occurred_at"/><field name="channel"/><field name="direction"/><field name="status"/><field name="message_id"/><field name="correlation_id"/></list></field></page>
    <page string="Appointments"><field name="codestra_appointment_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="scheduled_start"/><field name="appointment_type_id"/><field name="assigned_agent_id"/><field name="status"/><field name="meeting_channel"/></list></field></page>
    <page string="Documents"><field name="codestra_document_ids" readonly="1"/><field name="codestra_case_ids" readonly="1"/><field name="codestra_data_quality_issue_ids" readonly="1"/></page>
   </xpath>
  </field>
 </record>
 <record id="view_campaign_workflow_list" model="ir.ui.view"><field name="name">codestra.campaign.workflow.list</field><field name="model">codestra.campaign.workflow</field><field name="arch" type="xml"><list><field name="name"/><field name="key"/><field name="campaign_id"/><field name="lifecycle_state"/><field name="active"/><field name="version"/></list></field></record>
 <record id="view_campaign_workflow_form" model="ir.ui.view"><field name="name">codestra.campaign.workflow.form</field><field name="model">codestra.campaign.workflow</field><field name="arch" type="xml"><form string="Campaign Builder"><header><button name="action_validate_configuration" type="object" string="Validate" class="btn-primary" invisible="lifecycle_state != 'DRAFT'"/><button name="action_stage" type="object" string="Move to Staging" class="btn-primary" invisible="lifecycle_state != 'VALIDATED'"/><button name="action_activate" type="object" string="Activate" class="btn-primary" groups="call_center_core.group_call_center_admin" invisible="lifecycle_state != 'STAGING'"/><field name="lifecycle_state" widget="statusbar" statusbar_visible="DRAFT,VALIDATED,STAGING,ACTIVE"/></header><sheet><group><field name="name"/><field name="key"/><field name="campaign_id"/><field name="version"/><field name="active" readonly="1"/></group><notebook><page string="Statuses"><field name="status_ids"><list editable="bottom"><field name="sequence"/><field name="code"/><field name="display_name"/><field name="terminal"/><field name="next_action_required"/><field name="followup_sla_minutes"/></list></field></page><page string="Appointment Types"><field name="appointment_type_ids"><list editable="bottom"><field name="code"/><field name="name"/><field name="duration_minutes"/><field name="active"/></list></field></page></notebook></sheet></form></field></record>
 <record id="view_campaign_status_list" model="ir.ui.view"><field name="name">codestra.campaign.status.list</field><field name="model">codestra.campaign.status</field><field name="arch" type="xml"><list><field name="workflow_id"/><field name="code"/><field name="display_name"/><field name="sequence"/><field name="terminal"/><field name="next_action_required"/><field name="followup_sla_minutes"/><field name="report_category"/></list></field></record>
 <record id="view_crm_appointment_list" model="ir.ui.view"><field name="name">codestra.crm.appointment.list</field><field name="model">codestra.crm.appointment</field><field name="arch" type="xml"><list><field name="scheduled_start"/><field name="campaign_id"/><field name="appointment_type_id"/><field name="assigned_agent_id"/><field name="supervisor_id"/><field name="status"/><field name="meeting_channel"/></list></field></record>
 <record id="view_timeline_list" model="ir.ui.view"><field name="name">codestra.activity.timeline.list</field><field name="model">codestra.activity.timeline</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="occurred_at"/><field name="event_type"/><field name="actor_type"/><field name="actor_id"/><field name="campaign_id"/><field name="lead_id"/><field name="action"/><field name="visibility"/><field name="correlation_id"/></list></field></record>
 <record id="view_agent_profile_list" model="ir.ui.view"><field name="name">codestra.agent.profile.list</field><field name="model">codestra.agent.profile</field><field name="arch" type="xml"><list><field name="name"/><field name="agent_type"/><field name="user_id"/><field name="campaign_ids" widget="many2many_tags"/><field name="team_id"/><field name="supervisor_id"/><field name="daily_capacity"/><field name="active"/></list></field></record>
 <record id="view_agent_performance_pivot" model="ir.ui.view"><field name="name">codestra.agent.performance.pivot</field><field name="model">codestra.agent.performance</field><field name="arch" type="xml"><pivot string="Campaign Agent Performance"><field name="campaign_id" type="row"/><field name="agent_id" type="row"/><field name="leads_assigned" type="measure"/><field name="calls_attempted" type="measure"/><field name="contacts" type="measure"/><field name="qualified" type="measure"/><field name="won" type="measure"/><field name="overdue_followups" type="measure"/></pivot></field></record>
 <record id="view_work_queue_list" model="ir.ui.view"><field name="name">codestra.work.queue.item.list</field><field name="model">codestra.work.queue.item</field><field name="arch" type="xml"><list decoration-danger="priority &lt;= 3 and state == 'OPEN'" decoration-muted="state != 'OPEN'"><field name="priority"/><field name="due_at"/><field name="reason"/><field name="next_action"/><field name="lead_id"/><field name="campaign_id"/><field name="owner_id"/><field name="state"/></list></field></record>
 <record id="view_communication_list" model="ir.ui.view"><field name="name">codestra.campaign.communication.list</field><field name="model">codestra.campaign.communication</field><field name="arch" type="xml"><list create="0"><field name="occurred_at"/><field name="channel"/><field name="direction"/><field name="lead_id"/><field name="campaign_id"/><field name="status"/><field name="message_id"/><field name="correlation_id"/></list></field></record>
 <record id="view_communication_search" model="ir.ui.view"><field name="name">codestra.campaign.communication.search</field><field name="model">codestra.campaign.communication</field><field name="arch" type="xml"><search><field name="lead_id"/><field name="campaign_id"/><field name="correlation_id"/><filter name="email" string="Email" domain="[('channel','=','EMAIL')]"/><filter name="sms" string="SMS" domain="[('channel','=','SMS')]"/><filter name="inbound" string="Inbound" domain="[('direction','=','INBOUND')]"/><filter name="outbound" string="Outbound" domain="[('direction','=','OUTBOUND')]"/><filter name="failed" string="Failed" domain="[('status','in',('BOUNCED','FAILED'))]"/><group><filter name="group_campaign" string="Campaign" context="{'group_by':'campaign_id'}"/><filter name="group_channel" string="Channel" context="{'group_by':'channel'}"/><filter name="group_status" string="Status" context="{'group_by':'status'}"/></group></search></field></record>
 <record id="view_document_list" model="ir.ui.view"><field name="name">codestra.campaign.document.list</field><field name="model">codestra.campaign.document</field><field name="arch" type="xml"><list><field name="lead_id"/><field name="campaign_id"/><field name="definition_id"/><field name="state"/><field name="requested_at"/><field name="received_at"/><field name="expires_at"/></list></field></record>
 <record id="view_daily_report_list" model="ir.ui.view"><field name="name">codestra.daily.operations.report.list</field><field name="model">codestra.daily.operations.report</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="report_date"/><field name="business_unit_id"/><field name="campaign_id"/><field name="generated_at"/><field name="source_watermark"/><field name="correlation_id"/></list></field></record>
 <record id="view_daily_report_pivot" model="ir.ui.view"><field name="name">codestra.daily.operations.report.pivot</field><field name="model">codestra.daily.operations.report</field><field name="arch" type="xml"><pivot string="Campaign Daily Operations"><field name="business_unit_id" type="row"/><field name="campaign_id" type="row"/><field name="report_date" interval="day" type="col"/></pivot></field></record>
 <record id="view_contact_center_case_list" model="ir.ui.view"><field name="name">codestra.contact.center.case.list</field><field name="model">codestra.contact.center.case</field><field name="arch" type="xml"><list><field name="case_number"/><field name="customer_id"/><field name="campaign_id"/><field name="case_type"/><field name="priority"/><field name="owner_id"/><field name="state"/><field name="sla_state"/><field name="sla_due_at"/></list></field></record>
