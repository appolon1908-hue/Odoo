<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_codestra_data_quality_issue_list" model="ir.ui.view">
    <field name="name">codestra.data.quality.issue.list</field>
    <field name="model">codestra.data.quality.issue</field>
    <field name="arch" type="xml">
      <list string="Data Quality Issues" default_order="severity desc, create_date desc">
        <field name="name"/>
        <field name="res_model"/>
        <field name="res_id"/>
        <field name="duplicate_res_id"/>
        <field name="issue_type"/>
        <field name="severity" widget="priority"/>
        <field name="assignee_id"/>
        <field name="state"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>
  <record id="view_codestra_data_quality_issue_form" model="ir.ui.view">
    <field name="name">codestra.data.quality.issue.form</field>
    <field name="model">codestra.data.quality.issue</field>
    <field name="arch" type="xml">
      <form string="Data Quality Issue">
        <header>
          <button name="action_start_review" type="object" string="Start Review" class="btn-primary" invisible="state != 'open'"/>
          <button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state not in ('open', 'in_review')"/>
          <button name="action_ignore" type="object" string="Ignore" invisible="state not in ('open', 'in_review')"/>
          <button name="action_reopen" type="object" string="Reopen" invisible="state not in ('resolved', 'ignored')"/>
          <field name="state" widget="statusbar" statusbar_visible="open,in_review,resolved,ignored"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="res_model"/>
              <field name="res_id"/>
              <field name="duplicate_res_id"/>
              <field name="issue_type"/>
            </group>
            <group>
              <field name="severity" widget="priority"/>
              <field name="normalized_value"/>
              <field name="assignee_id"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </group>
          <field name="resolution"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_codestra_data_quality_issues" model="ir.actions.act_window">
    <field name="name">Data Quality</field>
    <field name="res_model">codestra.data.quality.issue</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_codestra_data_quality" name="Data Quality" parent="call_center_core.menu_call_center_root" action="action_codestra_data_quality_issues" sequence="81" groups="call_center_core.group_call_center_manager"/>
</odoo>
