<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_cc_audit_event_list" model="ir.ui.view">
    <field name="name">cc.audit.event.list</field>
    <field name="model">cc.audit.event</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="occurred_at"/>
        <field name="event_type"/>
        <field name="campaign_id" optional="show"/>
        <field name="actor_id"/>
        <field name="actor_role"/>
        <field name="action"/>
        <field name="result"/>
        <field name="reason_code" optional="show"/>
        <field name="correlation_id" optional="hide"/>
      </list>
    </field>
  </record>
  <record id="view_cc_audit_event_form" model="ir.ui.view">
    <field name="name">cc.audit.event.form</field>
    <field name="model">cc.audit.event</field>
    <field name="arch" type="xml">
      <form create="false" edit="false" delete="false">
        <sheet>
          <group>
            <field name="event_uuid"/>
            <field name="occurred_at"/>
            <field name="event_type"/>
            <field name="action"/>
            <field name="result"/>
          </group>
          <group>
            <field name="campaign_id"/>
            <field name="business_unit_id"/>
            <field name="actor_id"/>
            <field name="actor_role"/>
            <field name="target_model"/>
            <field name="target_record_id"/>
          </group>
          <group>
            <field name="reason_code"/>
            <field name="reason_hash"/>
            <field name="correlation_id"/>
            <field name="causation_id"/>
            <field name="source_system"/>
            <field name="source_reference_hash"/>
          </group>
          <group>
            <field name="metadata"/>
            <field name="payload_hash"/>
            <field name="previous_hash"/>
            <field name="record_hash"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_cc_audit_event" model="ir.actions.act_window">
    <field name="name">Governed Audit Evidence</field>
    <field name="res_model">cc.audit.event</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
  </record>
  <menuitem id="menu_cc_governed_audit" name="Governed Audit Evidence"
            parent="call_center_core.menu_call_center_root"
            action="action_cc_audit_event" sequence="96"
            groups="codestra_cc_security.group_cc_compliance_officer,codestra_cc_security.group_cc_auditor,codestra_cc_security.group_cc_global_administrator"/>
</odoo>
