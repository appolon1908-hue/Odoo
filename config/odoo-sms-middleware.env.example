# Values are examples, not production credentials. Keep delivery closed until
# the reviewed Middleware API, identity, provider and sender are configured.
CODESTRA_SMS_ENABLED=false
ALLOW_LIVE_SMS=false
CODESTRA_SMS_API_BASE_URL=https://middleware.internal.example
CODESTRA_SMS_TOKEN_URL=https://auth.codestra.co/realms/codestra/protocol/openid-connect/token
CODESTRA_SMS_CLIENT_SECRET_FILE=/run/secrets/odoo_sms_client_secret
CODESTRA_SMS_CA_FILE=/run/secrets/odoo_sms_ca_bundle.pem
CODESTRA_SMS_TENANT_ID=replace-with-authorized-tenant
CODESTRA_SMS_COMPANY_ID=1
CODESTRA_SMS_BUSINESS_UNIT_ID=1
CODESTRA_SMS_SENDER=ApprovedSender
CODESTRA_SMS_BILLING_ACCOUNT_ID=replace-with-approved-account
